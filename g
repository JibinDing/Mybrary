SELECT DISTINCT
    CSE.CASE_NUMBER,
    OUTC.APPLICATION_IDENTIFIER,
    OUTC.APPLICATION_DECISION_DATE,
    OUTC.FULL_APPLICATION_STATUS_CODE
FROM PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB.FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME OUTC
JOIN PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB.FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE CSE
    ON OUTC.APPLICATION_IDENTIFIER = CSE.APPLICATION_IDENTIFIER
WHERE OUTC.APPLICATION_DECISION_DATE = '2026-08-18'
  AND OUTC.FULL_APPLICATION_STATUS_CODE = 'COMPLETE'
ORDER BY CSE.CASE_NUMBER;