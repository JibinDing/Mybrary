SELECT
    QUOTE_STATUS_CODE,
    QTIND,
    COUNT(*) AS ROW_COUNT,
    COUNT(DISTINCT APPLICATION_IDENTIFIER) AS DISTINCT_APPLICATIONS
FROM FQ_FINAL2
WHERE CASE_CREATION_DATE = '2026-08-18'
  AND FULL_APPLICATION_STATUS_CODE = 'COMPLETE'
GROUP BY
    QUOTE_STATUS_CODE,
    QTIND
ORDER BY
    QUOTE_STATUS_CODE,
    QTIND;