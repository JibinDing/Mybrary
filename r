SELECT
    CASE
        WHEN NET_MONTHLY_INCOME_AMOUNT IS NULL THEN 'Unknown'
        WHEN NET_MONTHLY_INCOME_AMOUNT * 12 < 10000 THEN 'Under £10k'
        WHEN NET_MONTHLY_INCOME_AMOUNT * 12 < 15000 THEN '£10k-£15k'
        WHEN NET_MONTHLY_INCOME_AMOUNT * 12 < 22500 THEN '£15k-£22.5k'
        WHEN NET_MONTHLY_INCOME_AMOUNT * 12 < 30000 THEN '£22.5k-£30k'
        WHEN NET_MONTHLY_INCOME_AMOUNT * 12 < 50000 THEN '£30k-£50k'
        WHEN NET_MONTHLY_INCOME_AMOUNT * 12 < 75000 THEN '£50k-£75k'
        WHEN NET_MONTHLY_INCOME_AMOUNT * 12 < 150000 THEN '£75k-£150k'
        WHEN NET_MONTHLY_INCOME_AMOUNT * 12 < 250000 THEN '£150k-£250k'
        WHEN NET_MONTHLY_INCOME_AMOUNT * 12 < 500000 THEN '£250k-£500k'
        ELSE '£500k+'
    END AS SALARY_BAND,
    COUNT(*) AS RECORD_COUNT
FROM PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB
     .FDP_UK_CARDS_DB
     .CREDIT_CARD_APPLICATION_DECISION_OUTCOME
WHERE AUDIT_DATE >= DATEADD(MONTH, -1, CURRENT_DATE())
GROUP BY 1
ORDER BY 1;