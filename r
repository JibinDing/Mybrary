,A.MONTHLY_DISPOSABLE_INCOME_AMOUNT

,CAST(
    CASE
        WHEN A.MONTHLY_DISPOSABLE_INCOME_AMOUNT IS NULL
            THEN 'Unknown'
        WHEN A.MONTHLY_DISPOSABLE_INCOME_AMOUNT * 12 < 10000
            THEN 'Under £10k'
        WHEN A.MONTHLY_DISPOSABLE_INCOME_AMOUNT * 12 < 15000
            THEN '£10k-£15k'
        WHEN A.MONTHLY_DISPOSABLE_INCOME_AMOUNT * 12 < 22500
            THEN '£15k-£22.5k'
        WHEN A.MONTHLY_DISPOSABLE_INCOME_AMOUNT * 12 < 30000
            THEN '£22.5k-£30k'
        WHEN A.MONTHLY_DISPOSABLE_INCOME_AMOUNT * 12 < 50000
            THEN '£30k-£50k'
        WHEN A.MONTHLY_DISPOSABLE_INCOME_AMOUNT * 12 < 75000
            THEN '£50k-£75k'
        WHEN A.MONTHLY_DISPOSABLE_INCOME_AMOUNT * 12 < 150000
            THEN '£75k-£150k'
        WHEN A.MONTHLY_DISPOSABLE_INCOME_AMOUNT * 12 < 250000
            THEN '£150k-£250k'
        WHEN A.MONTHLY_DISPOSABLE_INCOME_AMOUNT * 12 < 500000
            THEN '£250k-£500k'
        ELSE '£500k+'
    END
    AS VARCHAR(20)
) AS SALARY_BAND