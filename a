
SELECT
    COUNT(*) AS SOURCE_ROWS,
    COUNT(DISTINCT CAS.APPLICATION_ID) AS SOURCE_IDS,
    COUNT(DISTINCT REC.APPLICATION_ID) AS MART_MATCHED_IDS
FROM A_UKC_CASMART_DB.APPLICATION CAS
LEFT JOIN U_BUKC_DSA_BIV_BT_DB.RECRUITMENT_MART0 REC
    ON CAS.APPLICATION_ID = REC.APPLICATION_ID
WHERE CAS.CREATED_DATE >= '2026-09-01'
  AND CAS.CREATED_DATE < '2026-09-02'
  AND CAS.DECISION_DATE >= '2026-09-01'
  AND CAS.DECISION_DATE < '2026-10-01';
