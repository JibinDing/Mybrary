SELECT
    B.LINKED_APPLICATION_NUMBER,
    B.APPLICATION_IDENTIFIER,
    B.EFF_START_DATE,
    B.CASE_CREATION_DATE,
    B.APPLICATION_APPROVAL_DATE,
    B.FULL_APPLICATION_STATUS_CODE,
    B.LATEST_APP_RN
FROM BASE B
JOIN COMPLETE_GROUPS C
  ON B.LINKED_APPLICATION_NUMBER = C.LINKED_APPLICATION_NUMBER
WHERE B.LINKED_APPLICATION_NUMBER IN (
    SELECT LINKED_APPLICATION_NUMBER
    FROM BASE
    WHERE LATEST_APP_RN = 1
      AND UPPER(TRIM(FULL_APPLICATION_STATUS_CODE)) <> 'COMPLETE'
)
ORDER BY
    B.LINKED_APPLICATION_NUMBER,
    B.APPLICATION_IDENTIFIER;