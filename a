WITH latest_status AS (
    SELECT *
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS
    WHERE SOURCE_CHANGE_TIMESTAMP >= DATEADD(
        HOUR,
        -120,
        (SELECT MAX(REPORT_HOUR)
         FROM BDP_UK_CARDS.FACT_SMARTPAY_TRANSACTION_SUMMARY)
    )
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY TRANSACTION_IDENTIFIER
        ORDER BY SOURCE_CHANGE_TIMESTAMP DESC
    ) = 1
),

auth AS (
    SELECT *
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_AUTHORIZATION_TRANSACTION
    WHERE TRIM(TRANSACTION_PURPOSE_CODE) IN (
        'DPNGCB','NGCBRF',
        'RL_BLD','RH_BLD','FL_BLD',
        'FH_BLD','IH_BLD','IL_BLD'
    )
)

SELECT
    COUNT(DISTINCT s.TRANSACTION_IDENTIFIER) AS STATUS_TXNS,
    COUNT(DISTINCT CASE
        WHEN a.TRANSACTION_IDENTIFIER IS NOT NULL
        THEN s.TRANSACTION_IDENTIFIER
    END) AS MATCHED_TXNS,
    COUNT(*) AS ROWS_AFTER_JOIN,
    COUNT(DISTINCT a.TRANSACTION_IDENTIFIER) AS DISTINCT_AUTH_TXNS
FROM latest_status s
LEFT JOIN auth a
    ON s.TRANSACTION_IDENTIFIER = a.TRANSACTION_IDENTIFIER;