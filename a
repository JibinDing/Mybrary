SELECT COUNT(*) AS BAD_GROUP_COUNT
FROM (
    SELECT
        LINKED_APPLICATION_NUMBER
    FROM BASE
    GROUP BY LINKED_APPLICATION_NUMBER
    HAVING
        MAX(
            CASE
                WHEN UPPER(TRIM(FULL_APPLICATION_STATUS_CODE)) = 'COMPLETE'
                THEN 1 ELSE 0
            END
        ) = 1

        AND MAX(
            CASE
                WHEN RN = 1
                 AND UPPER(TRIM(FULL_APPLICATION_STATUS_CODE)) = 'COMPLETE'
                THEN 1 ELSE 0
            END
        ) = 0
);