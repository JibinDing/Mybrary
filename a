
SELECT
    COUNT(*) AS SOURCE_TOTAL_ROWS,
    COUNT(DISTINCT APPLICATION_ID)
        AS DISTINCT_APPLICATION_IDS,
    COUNT(*) - COUNT(DISTINCT APPLICATION_ID)
        AS DUPLICATE_ROWS
FROM A_UKC_CASMART_DB.APPLICATION
WHERE CREATED_DATE >= '2026-09-05'
  AND CREATED_DATE < '2026-09-06'
  AND DECISION_DATE >= '2026-09-01'
  AND DECISION_DATE < '2026-10-01';
