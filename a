SELECT
    COUNT(*) AS TOTAL_ROWS,
    MIN(REPORT_HOUR) AS MIN_REPORT_HOUR,
    MAX(REPORT_HOUR) AS MAX_REPORT_HOUR,
    MAX(DW_LOD_TMP) AS LAST_LOAD_TIMESTAMP
FROM BDP_UK_CARDS.FACT_SMARTPAY_TRANSACTION_SUMMARY;

SELECT
    REPORT_DATE,
    COUNT(*) AS ROW_COUNT,
    SUM(MEASURE_VOLUME) AS MEASURE_VOLUME,
    SUM(MEASURE_VALUE) AS MEASURE_VALUE
FROM BDP_UK_CARDS.FACT_SMARTPAY_TRANSACTION_SUMMARY
GROUP BY REPORT_DATE
ORDER BY REPORT_DATE DESC
LIMIT 10;


SHOW TASKS LIKE 'TASK_FACT_SMARTPAY_TRANSACTION_SUMMARY';

SELECT *
FROM TABLE(
    INFORMATION_SCHEMA.TASK_HISTORY(
        SCHEDULED_TIME_RANGE_START => DATEADD('DAY', -7, CURRENT_TIMESTAMP()),
        TASK_NAME => 'TASK_FACT_SMARTPAY_TRANSACTION_SUMMARY',
        RESULT_LIMIT => 100
    )
)
ORDER BY SCHEDULED_TIME DESC;







SELECT
    METRIC_IDENTIFIER,
    REPORT_DATE,
    REPORT_HOUR,
    SOURCE_SYSTEM_KEY,
    TRANSACTION_CHANNEL_NAME,
    PRODUCT_GROUP_KEY,
    TRANSACTION_STATUS_KEY,
    ERROR_MESSAGE_DESCRIPTION,
    COUNT(*) AS CNT
FROM BDP_UK_CARDS.FACT_SMARTPAY_TRANSACTION_SUMMARY
GROUP BY
    METRIC_IDENTIFIER,
    REPORT_DATE,
    REPORT_HOUR,
    SOURCE_SYSTEM_KEY,
    TRANSACTION_CHANNEL_NAME,
    PRODUCT_GROUP_KEY,
    TRANSACTION_STATUS_KEY,
    ERROR_MESSAGE_DESCRIPTION
HAVING COUNT(*) > 1
ORDER BY CNT DESC;



SELECT
    TRANSACTION_STATUS_KEY,
    COUNT(*) AS ROW_COUNT,
    COUNT_IF(ERROR_MESSAGE_DESCRIPTION IS NULL) AS NULL_ERROR_COUNT,
    COUNT_IF(ERROR_MESSAGE_DESCRIPTION IS NOT NULL) AS POPULATED_ERROR_COUNT,
    SUM(MEASURE_VOLUME) AS TRANSACTION_VOLUME
FROM BDP_UK_CARDS.FACT_SMARTPAY_TRANSACTION_SUMMARY
GROUP BY TRANSACTION_STATUS_KEY
ORDER BY TRANSACTION_STATUS_KEY;



SELECT
    COUNT(*) AS TOTAL_ROWS,
    COUNT_IF(ERROR_MESSAGE_DESCRIPTION IS NULL) AS NULL_ROWS,
    COUNT_IF(ERROR_MESSAGE_DESCRIPTION IS NOT NULL) AS NON_NULL_ROWS
FROM BDP_UK_CARDS.FACT_SMARTPAY_TRANSACTION_SUMMARY;












