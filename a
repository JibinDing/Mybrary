SELECT
    MIN(APPLICATION_CREATED_DATE) AS FIRST_CREATED_DATE,
    MIN(APPLICATION_DECISION_DATE) AS FIRST_DECISION_DATE,

    COUNT_IF(
        APPLICATION_CREATED_DATE >= '2026-01-01'
        AND APPLICATION_CREATED_DATE < '2026-01-25'
    ) AS CREATED_ROWS_JAN_1_TO_24,

    COUNT_IF(
        APPLICATION_DECISION_DATE >= '2026-01-01'
        AND APPLICATION_DECISION_DATE < '2026-01-25'
    ) AS DECISION_ROWS_JAN_1_TO_24

FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY;