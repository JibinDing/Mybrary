SELECT
    ORIGIN_PART_2,
    ORIGIN_PART_3,

    CONCAT(
        COALESCE(TRIM(CAST(ORIGIN_PART_2 AS STRING)), ''),
        COALESCE(TRIM(CAST(ORIGIN_PART_3 AS STRING)), '')
    ) AS COMBINED_ORIGIN_CODE,

    COUNT(*) AS RECORD_COUNT

FROM E_CASMART_BASE.IF023_APPLICATION

WHERE ORIGIN_PART_2 IS NOT NULL
   OR ORIGIN_PART_3 IS NOT NULL

GROUP BY
    ORIGIN_PART_2,
    ORIGIN_PART_3

ORDER BY RECORD_COUNT DESC

LIMIT 30;