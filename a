WITH latest_status AS (
    SELECT *
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS
    WHERE SOURCE_CHANGE_TIMESTAMP >= '2026-08-02 00:00:00'
      AND SOURCE_CHANGE_TIMESTAMP <= '2026-09-21 10:00:00'
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY TRANSACTION_IDENTIFIER
        ORDER BY
            SOURCE_CHANGE_TIMESTAMP DESC,
            SOURCE_INSERT_TIMESTAMP DESC
    ) = 1
)

SELECT
    COUNT(DISTINCT a.TRANSACTION_IDENTIFIER) AS FDP_TRANSACTION_VOLUME
FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_AUTHORIZATION_TRANSACTION a
JOIN latest_status s
    ON a.TRANSACTION_IDENTIFIER = s.TRANSACTION_IDENTIFIER
WHERE s.TRANSACTION_STATUS_CODE NOT IN (
    'DUPLICATE_POSTED_TRAN',
    'GATHER_BROWSER_INFO',
    'VALIDATION_FAILED',
    'DIARY_NOTE_MADE'
)
AND TRIM(a.TRANSACTION_PURPOSE_CODE) IN (
    'DPNGCB',
    'NGCBRF',
    'RL_BLD',
    'RH_BLD',
    'FL_BLD',
    'FH_BLD',
    'IH_BLD',
    'IL_BLD'
);