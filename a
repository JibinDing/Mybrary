SELECT
    CASE
        WHEN GROUPING(
            DATE_TRUNC('MONTH', APPLICATION_CREATED_DATE)
        ) = 1 THEN 'TOTAL'

        WHEN APPLICATION_CREATED_DATE IS NULL
        THEN 'NULL'

        ELSE TO_CHAR(
            DATE_TRUNC('MONTH', APPLICATION_CREATED_DATE),
            'YYYY-MM'
        )
    END AS APPLICATION_MONTH,

    SUM(
        COALESCE(APPLICATION_COUNT, 0)
    ) AS APPLICATION_VOLUME

FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

WHERE APPLICATION_DECISION_DATE >= DATE '2026-09-01'
  AND APPLICATION_DECISION_DATE < DATE '2026-10-01'

GROUP BY ROLLUP(
    DATE_TRUNC('MONTH', APPLICATION_CREATED_DATE)
)

ORDER BY
    GROUPING(DATE_TRUNC('MONTH', APPLICATION_CREATED_DATE)),
    APPLICATION_MONTH;