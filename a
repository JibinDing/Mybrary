SELECT
    APPLICATION_CREATED_DATE,
    SUM(COALESCE(APPLICATION_COUNT, 0)) AS APPLICATION_COUNT
FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY
WHERE APPLICATION_CREATED_DATE >= '2026-09-01'
  AND APPLICATION_CREATED_DATE < '2026-10-01'
GROUP BY APPLICATION_CREATED_DATE
ORDER BY APPLICATION_CREATED_DATE;