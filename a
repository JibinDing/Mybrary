Test Case Type:
Total Eligibility Checks Reconciliation

Test Case Long Description:
Validate that Total Eligibility Checks reconcile to the sum of API Quote Eligibility Checks, Aggregator On-Us Eligibility and Direct On-Us Eligibility for each application decision date.

Expected Results:
Total Eligibility Checks should equal API Quote Eligibility Checks + Aggregator On-Us Eligibility + Direct On-Us Eligibility, with zero difference and zero mismatched decision dates.

Actual Results:
[跑完后填]

Status:
[PASS / FAIL]



WITH DAILY_CHECK AS (
    SELECT
        APPLICATION_DECISION_DATE,

        SUM(COALESCE(ELIGIBILITY_CHECK_COUNT, 0))
            AS TOTAL_ELIGIBILITY_CHECKS,

        SUM(COALESCE(API_QUOTE_COUNT, 0))
            AS API_QUOTE_ELIGIBILITY_CHECKS,

        SUM(COALESCE(API_ACCEPT_ON_US_CHECK_COUNT, 0))
            AS AGGREGATOR_ON_US_ELIGIBILITY,

        SUM(COALESCE(DIRECT_ON_US_CHECK_COUNT, 0))
            AS DIRECT_ON_US_ELIGIBILITY

    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

    WHERE APPLICATION_DECISION_DATE IS NOT NULL

    GROUP BY APPLICATION_DECISION_DATE
),

VALIDATION AS (
    SELECT
        *,
        API_QUOTE_ELIGIBILITY_CHECKS
        + AGGREGATOR_ON_US_ELIGIBILITY
        + DIRECT_ON_US_ELIGIBILITY
            AS CALCULATED_TOTAL,

        TOTAL_ELIGIBILITY_CHECKS
        -
        (
            API_QUOTE_ELIGIBILITY_CHECKS
            + AGGREGATOR_ON_US_ELIGIBILITY
            + DIRECT_ON_US_ELIGIBILITY
        ) AS DIFFERENCE

    FROM DAILY_CHECK
)

SELECT
    SUM(TOTAL_ELIGIBILITY_CHECKS) AS TOTAL_ELIGIBILITY_CHECKS,

    SUM(API_QUOTE_ELIGIBILITY_CHECKS)
        AS API_QUOTE_ELIGIBILITY_CHECKS,

    SUM(AGGREGATOR_ON_US_ELIGIBILITY)
        AS AGGREGATOR_ON_US_ELIGIBILITY,

    SUM(DIRECT_ON_US_ELIGIBILITY)
        AS DIRECT_ON_US_ELIGIBILITY,

    SUM(CALCULATED_TOTAL)
        AS CALCULATED_TOTAL,

    SUM(DIFFERENCE)
        AS TOTAL_DIFFERENCE,

    COUNT_IF(DIFFERENCE <> 0)
        AS MISMATCHED_DAYS,

    CASE
        WHEN SUM(DIFFERENCE) = 0
         AND COUNT_IF(DIFFERENCE <> 0) = 0
        THEN 'PASS'
        ELSE 'FAIL'
    END AS TEST_RESULT

FROM VALIDATION;

