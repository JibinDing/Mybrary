WITH latest_status AS (
    SELECT *
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS
    WHERE SOURCE_CHANGE_TIMESTAMP >= '2026-09-09 01:00:00'
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY TRANSACTION_IDENTIFIER
        ORDER BY SOURCE_CHANGE_TIMESTAMP DESC
    ) = 1
)

SELECT
    a.TRANSACTION_IDENTIFIER,
    a.TRANSACTION_CHANNEL_CODE,
    a.TRANSACTION_PURPOSE_CODE,
    s.TRANSACTION_STATUS_CODE,
    s.ERROR_DESCRIPTION,
    s.SOURCE_SYSTEM_KEY,
    s.SOURCE_CHANGE_TIMESTAMP
FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_AUTHORIZATION_TRANSACTION a

JOIN latest_status s
    ON a.TRANSACTION_IDENTIFIER = s.TRANSACTION_IDENTIFIER

WHERE DATE_TRUNC('HOUR', s.SOURCE_CHANGE_TIMESTAMP)
        = '2026-09-11 17:00:00'

  AND a.TRANSACTION_CHANNEL_CODE = 206

  AND TRIM(a.TRANSACTION_PURPOSE_CODE) IN (
      'DPNGCB',
      'NGCBRF',
      'RL_BLD',
      'RH_BLD',
      'FL_BLD',
      'FH_BLD',
      'IH_BLD',
      'IL_BLD'
  )

  AND s.TRANSACTION_STATUS_CODE NOT IN (
      'DUPLICATE_POSTED_TRAN',
      'GATHER_BROWSER_INFO',
      'VALIDATION_FAILED',
      'DIARY_NOTE_MADE'
  )

ORDER BY s.TRANSACTION_STATUS_CODE;