SELECT
    CASE
        WHEN AUDIT_DATE < '2026-01-25'
            THEN 'Jan 01-24'
        ELSE 'Jan 25-31'
    END AS PERIOD,
    COUNT(*) AS TOTAL_RECORDS,
    COUNT(DISTINCT APPLICATION_IDENTIFIER) AS DISTINCT_APPLICATIONS,
    COUNT_IF(QUOTE_STATUS_CODE = 'F') AS FULL_APPLICATION_RECORDS,
    MIN(AUDIT_DATE) AS EARLIEST_AUDIT_DATE,
    MAX(AUDIT_DATE) AS LATEST_AUDIT_DATE
FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME
WHERE AUDIT_DATE >= '2026-01-01'
  AND AUDIT_DATE < '2026-02-01'
GROUP BY 1
ORDER BY 1;