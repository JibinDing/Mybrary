SELECT
    TABLE_SCHEMA,
    TABLE_NAME,
    COLUMN_NAME,
    DATA_TYPE
FROM PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB.INFORMATION_SCHEMA.COLUMNS
WHERE
       UPPER(COLUMN_NAME) LIKE '%MARKET%'
    OR UPPER(COLUMN_NAME) LIKE '%CONSENT%'
    OR UPPER(COLUMN_NAME) LIKE '%COOKIE%'
    OR UPPER(COLUMN_NAME) LIKE '%OPT_OUT%'
    OR UPPER(COLUMN_NAME) LIKE '%OPTOUT%'
ORDER BY
    TABLE_SCHEMA,
    TABLE_NAME,
    COLUMN_NAME;