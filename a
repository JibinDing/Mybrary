SELECT
    f.TRANSACTION_STATUS_KEY,
    r.REFERENCE_DETAIL_NAME AS TRANSACTION_STATUS_NAME,
    COUNT(*) AS ROW_COUNT,
    SUM(f.MEASURE_VOLUME) AS TRANSACTION_VOLUME
FROM BDP_UK_CARDS.FACT_SMARTPAY_TRANSACTION_SUMMARY f
LEFT JOIN BDP_UK_CARDS.DIM_REFERENCE r
    ON f.TRANSACTION_STATUS_KEY = r.REFERENCE_KEY
   AND r.REFERENCE_CATEGORY_CODE = 1010
   AND r.ACTIVE = '1'
GROUP BY
    f.TRANSACTION_STATUS_KEY,
    r.REFERENCE_DETAIL_NAME
ORDER BY
    f.TRANSACTION_STATUS_KEY;