WITH smartpay_auth AS (
    SELECT DISTINCT
        TRANSACTION_IDENTIFIER,
        CAST(SOURCE_INSERT_TIMESTAMP AS DATE) AS AUTH_DATE
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_AUTHORIZATION_TRANSACTION
    WHERE SOURCE_INSERT_TIMESTAMP >= '2026-08-02 00:00:00'
      AND TRIM(TRANSACTION_PURPOSE_CODE) IN (
          'DPNGCB',
          'NGCBRF',
          'RL_BLD',
          'RH_BLD',
          'FL_BLD',
          'FH_BLD',
          'IH_BLD',
          'IL_BLD'
      )
),

all_status AS (
    SELECT DISTINCT TRANSACTION_IDENTIFIER
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS
)

SELECT
    a.AUTH_DATE,
    COUNT(*) AS MISSING_STATUS_TRANSACTIONS
FROM smartpay_auth a
LEFT JOIN all_status s
    ON a.TRANSACTION_IDENTIFIER = s.TRANSACTION_IDENTIFIER
WHERE s.TRANSACTION_IDENTIFIER IS NULL
GROUP BY a.AUTH_DATE
ORDER BY a.AUTH_DATE;