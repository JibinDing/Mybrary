SELECT
    TABLE_NAME,
    COLUMN_NAME,
    DATA_TYPE
FROM PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB
    .INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'FDP_UK_CARDS_DB'
  AND TABLE_NAME IN (
      'CREDIT_CARD_APPLICATION_CASE',
      'CREDIT_CARD_APPLICATION_DECISION_OUTCOME'
  )
  AND (
      UPPER(COLUMN_NAME) LIKE '%STATUS%'
      OR UPPER(COLUMN_NAME) LIKE '%DECISION%'
  )
ORDER BY
    TABLE_NAME,
    ORDINAL_POSITION;