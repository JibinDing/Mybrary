SELECT
    APP.APPLICATION_IDENTIFIER,
    APP.LINKED_APPLICATION_NUMBER,
    APP.EFF_START_DATE,
    APP.APPLICATION_APPROVAL_DATE,
    APP.CHANNEL_CODE,
    APP.AGGREGATOR_PARTNER_CODE,
    APP.INTERNET_MEDIA_CODE,
    APP.MULTIQUOTE_INDICATOR,
    APP.VOID_BALANCE_TRANSFER_AMOUNT,
    CSE.CASE_CREATION_DATE,
    CSE.CASE_STATUS_CODE AS FULL_APPLICATION_STATUS_CODE,

    /* Current logic */
    ROW_NUMBER() OVER (
        PARTITION BY APP.LINKED_APPLICATION_NUMBER
        ORDER BY APP.EFF_START_DATE DESC
    ) AS CURRENT_RN,

    /* Simple deterministic candidate */
    ROW_NUMBER() OVER (
        PARTITION BY APP.LINKED_APPLICATION_NUMBER
        ORDER BY
            APP.EFF_START_DATE DESC,
            APP.APPLICATION_IDENTIFIER DESC
    ) AS LATEST_APP_RN

FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION APP

JOIN (
    SELECT
        APPLICATION_IDENTIFIER,
        CASE_NUMBER,
        CASE_CREATION_DATE,
        CASE_STATUS_CODE
    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE
    WHERE CASE_TYPE = 'PRODUCTAPP'
      AND ACTIVE = '1'
      AND CASE_CREATION_DATE >= '2026-01-01'
) CSE
    ON APP.APPLICATION_IDENTIFIER = CSE.APPLICATION_IDENTIFIER

WHERE APP.LINKED_APPLICATION_NUMBER IS NOT NULL
  AND APP.ACTIVE = '1';