SELECT
    CASE
        WHEN DOWNSELL_COUNT IS NULL THEN 'NULL'
        WHEN DOWNSELL_COUNT = 0 THEN '0'
        WHEN DOWNSELL_COUNT > 0 THEN '> 0'
        ELSE '< 0'
    END AS DOWNSELL_COUNT_GROUP,

    COUNT(*) AS RECORD_COUNT,

    MIN(DOWNSELL_COUNT) AS MIN_DOWNSELL_COUNT,
    MAX(DOWNSELL_COUNT) AS MAX_DOWNSELL_COUNT

FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME

GROUP BY 1

ORDER BY RECORD_COUNT DESC;