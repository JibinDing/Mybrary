SELECT
    'AUTHORIZATION' AS SOURCE_TABLE,
    MAX(SOURCE_INSERT_TIMESTAMP) AS LATEST_DATA
FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_AUTHORIZATION_TRANSACTION

UNION ALL

SELECT
    'TRANSACTION_STATUS' AS SOURCE_TABLE,
    MAX(SOURCE_CHANGE_TIMESTAMP) AS LATEST_DATA
FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS;