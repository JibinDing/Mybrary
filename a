SELECT
    APPLICATION_CREATED_DATE,

    SUM(ELIGIBILITY_CHECK_COUNT)
        AS TOTAL_ELIGIBILITY_CHECKS,

    SUM(API_QUOTE_COUNT)
        AS API_QUOTE_ELIGIBILITY_CHECKS,

    SUM(API_ACCEPT_ON_US_ACCEPT_APPLICATION_COUNT)
      + SUM(API_ACCEPT_ON_US_REFER_APPLICATION_COUNT)
        AS AGGREGATOR_QUOTE_TO_CONVERSION,

    SUM(API_ACCEPT_ON_US_CHECK_COUNT)
        AS AGGREGATOR_ON_US_ELIGIBILITY,

    SUM(API_ACCEPT_ON_US_ACCEPT_APPLICATION_COUNT)
      + SUM(API_ACCEPT_ON_US_REFER_APPLICATION_COUNT)
        AS AGGREGATOR_ON_US_ELIGIBILITY_CONVERSION,

    SUM(DIRECT_ON_US_CHECK_COUNT)
        AS DIRECT_ON_US_ELIGIBILITY,

    SUM(DIRECT_ON_US_ACCEPT_APPLICATION_COUNT)
      + SUM(DIRECT_ON_US_REFER_APPLICATION_COUNT)
      + SUM(DIRECT_ON_US_DECLINE_APPLICATION_COUNT)
        AS DIRECT_ON_US_ELIGIBILITY_CONVERSION

FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

WHERE APPLICATION_CREATED_DATE = '2026-08-01'

GROUP BY APPLICATION_CREATED_DATE;