
WITH TARGET_APPS AS (
    SELECT
        APPLICATION_ID
    FROM A_UKC_CASMART_DB.APPLICATION
    WHERE CREATED_DATE >= '2026-09-01'
      AND CREATED_DATE < '2026-09-02'
      AND DECISION_DATE >= '2026-09-01'
      AND DECISION_DATE < '2026-10-01'
),

SDS_SORT AS (
    SELECT
        A.APPLICATION_ID,
        A.AUDIT_TIMESTAMP,
        A.SDS_COUNTER,
        RANK() OVER (
            PARTITION BY A.APPLICATION_ID
            ORDER BY
                A.QUOTATION_INDICATOR DESC,
                B.SDS_COUNTER_MI
        ) AS PASS_ORDER,
        RANK() OVER (
            PARTITION BY A.APPLICATION_ID
            ORDER BY
                A.QUOTATION_INDICATOR,
                B.SDS_COUNTER_MI DESC
        ) AS LAST_PASS
    FROM E_CASMART_BASE.IF023_APPLICATION A
    JOIN E_CASMART_BASE.IF023_RESULTS1 B
      ON A.APPLICATION_ID = B.APPLICATION_ID
     AND A.AUDIT_TIMESTAMP = B.AUDIT_TIMESTAMP
     AND A.SDS_COUNTER = B.SDS_COUNTER
    WHERE A.AUDIT_DATE >= '2026-09-01'
      AND B.AUDIT_DATE >= '2026-09-01'
      AND A.APPLICATION_ID IN (
          SELECT APPLICATION_ID FROM TARGET_APPS
      )
),

SDSAPP AS (
    SELECT
        X.APPLICATION_ID,
        X.AUDIT_TIMESTAMP,
        X.SDS_COUNTER
    FROM E_CASMART_BASE.IF023_APPLICATION A
    JOIN SDS_SORT X
      ON X.APPLICATION_ID = A.APPLICATION_ID
     AND X.AUDIT_TIMESTAMP = A.AUDIT_TIMESTAMP
     AND X.SDS_COUNTER = A.SDS_COUNTER
    WHERE A.AUDIT_DATE >= '2026-09-01'
      AND X.LAST_PASS = 1
),

SDSSUM AS (
    SELECT X.APPLICATION_ID
    FROM E_CASMART_BASE.IF023_SUMMARY S
    JOIN SDSAPP X
      ON X.APPLICATION_ID = S.APPLICATION_ID
     AND X.AUDIT_TIMESTAMP = S.AUDIT_TIMESTAMP
     AND X.SDS_COUNTER = S.SDS_COUNTER
    WHERE S.AUDIT_DATE >= '2026-09-01'
)

SELECT DISTINCT
    T.APPLICATION_ID
FROM TARGET_APPS T
JOIN SDSSUM S
  ON T.APPLICATION_ID = S.APPLICATION_ID
JOIN U_BUKC_DSA_BIV_BT_DB.RECRUITMENT_MART0 R
  ON T.APPLICATION_ID = R.APPLICATION_ID
ORDER BY T.APPLICATION_ID;
