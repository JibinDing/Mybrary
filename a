SELECT
    'AUTHORIZATION' AS SOURCE_TABLE,
    MIN(SOURCE_INSERT_TIMESTAMP) AS EARLIEST_DATE,
    MAX(SOURCE_INSERT_TIMESTAMP) AS LATEST_DATE,
    COUNT(*) AS TOTAL_ROWS
FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_AUTHORIZATION_TRANSACTION

UNION ALL

SELECT
    'TRANSACTION_STATUS' AS SOURCE_TABLE,
    MIN(SOURCE_CHANGE_TIMESTAMP) AS EARLIEST_DATE,
    MAX(SOURCE_CHANGE_TIMESTAMP) AS LATEST_DATE,
    COUNT(*) AS TOTAL_ROWS
FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS;