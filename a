SELECT
    TO_DATE(APPLICATION_CREATED_DATE) AS APPLICATION_DATE,

    SUM(
        COALESCE(APPLICATION_COUNT, 0)
    ) AS NCMI_APPLICATION_VOLUME

FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

WHERE APPLICATION_DECISION_DATE >= DATE '2026-09-01'
  AND APPLICATION_DECISION_DATE < DATE '2026-10-01'

  AND APPLICATION_CREATED_DATE >= DATE '2026-09-01'
  AND APPLICATION_CREATED_DATE < DATE '2026-10-01'

GROUP BY 1
ORDER BY 1;