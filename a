SELECT COUNT(*) AS BAD_ALL_WITHDRAWN_GROUP_COUNT
FROM FINAL F
WHERE F.RN = 1

  /* this linked group must be all WITHDRAWN */
  AND NOT EXISTS (
      SELECT 1
      FROM FINAL X
      WHERE X.LINKED_APPLICATION_NUMBER = F.LINKED_APPLICATION_NUMBER
        AND UPPER(TRIM(X.FULL_APPLICATION_STATUS_CODE)) <> 'WITHDRAWN'
  )

  /* check whether a newer application exists */
  AND EXISTS (
      SELECT 1
      FROM FINAL X
      WHERE X.LINKED_APPLICATION_NUMBER = F.LINKED_APPLICATION_NUMBER
        AND (
             X.EFF_START_DATE > F.EFF_START_DATE
             OR (
                 X.EFF_START_DATE = F.EFF_START_DATE
                 AND X.APPLICATION_IDENTIFIER > F.APPLICATION_IDENTIFIER
             )
        )
  );