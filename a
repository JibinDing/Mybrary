SELECT
    REPORT_DATE,
    f.PRODUCT_GROUP_KEY,
    r.REFERENCE_DETAIL_NAME AS PRODUCT_GROUP_NAME,
    COUNT(*) AS ROW_COUNT,
    SUM(f.MEASURE_VOLUME) AS TRANSACTION_VOLUME,
    SUM(f.MEASURE_VALUE) AS MEASURE_VALUE
FROM BDP_UK_CARDS.FACT_SMARTPAY_TRANSACTION_SUMMARY f
LEFT JOIN BDP_UK_CARDS.DIM_REFERENCE r
    ON f.PRODUCT_GROUP_KEY = r.REFERENCE_KEY
   AND r.REFERENCE_CATEGORY_CODE = 10001
   AND r.ACTIVE = '1'
WHERE REPORT_DATE >= '2026-09-01'
  AND REPORT_DATE < '2026-10-01'
  AND UPPER(r.REFERENCE_DETAIL_NAME) = 'NGCB'
GROUP BY
    REPORT_DATE,
    f.PRODUCT_GROUP_KEY,
    r.REFERENCE_DETAIL_NAME
ORDER BY REPORT_DATE;






WITH status_txns AS (
    SELECT DISTINCT TRANSACTION_IDENTIFIER
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS
    WHERE SOURCE_CHANGE_TIMESTAMP >= '2026-08-01'
      AND SOURCE_CHANGE_TIMESTAMP <  '2026-10-01'
),

auth_txns AS (
    SELECT DISTINCT TRANSACTION_IDENTIFIER
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_AUTHORIZATION_TRANSACTION
    WHERE SOURCE_CHANGE_TIMESTAMP >= '2026-08-01'
      AND SOURCE_CHANGE_TIMESTAMP <  '2026-10-01'
)

SELECT
    COUNT(*) AS STATUS_ONLY_TRANSACTIONS
FROM status_txns s
LEFT JOIN auth_txns a
    ON s.TRANSACTION_IDENTIFIER = a.TRANSACTION_IDENTIFIER
WHERE a.TRANSACTION_IDENTIFIER IS NULL;








