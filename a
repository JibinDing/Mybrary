WITH status_ref AS (
    SELECT
        REFERENCE_KEY AS TRANSACTION_STATUS_KEY,
        REFERENCE_DETAIL_NAME AS TRANSACTION_STATUS_NAME
    FROM BDP_UK_CARDS.DIM_REFERENCE
    WHERE REFERENCE_CATEGORY_CODE = 1010
      AND ACTIVE = '1'

    UNION ALL

    SELECT
        -99 AS TRANSACTION_STATUS_KEY,
        'UNMAPPED / UNKNOWN' AS TRANSACTION_STATUS_NAME
)

SELECT
    r.TRANSACTION_STATUS_KEY,
    r.TRANSACTION_STATUS_NAME,
    COUNT(f.TRANSACTION_STATUS_KEY) AS ROW_COUNT,
    COALESCE(SUM(f.MEASURE_VOLUME), 0) AS TRANSACTION_VOLUME
FROM status_ref r
LEFT JOIN BDP_UK_CARDS.FACT_SMARTPAY_TRANSACTION_SUMMARY f
    ON f.TRANSACTION_STATUS_KEY = r.TRANSACTION_STATUS_KEY
GROUP BY
    r.TRANSACTION_STATUS_KEY,
    r.TRANSACTION_STATUS_NAME
ORDER BY
    r.TRANSACTION_STATUS_KEY;