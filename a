SELECT
    SUM(COALESCE(API_ACCEPT_ON_US_ACCEPT_APPLICATION_DECLINE_COUNT, 0))
        AS API_ACCEPT_ON_US_ACCEPT_APP_DECLINE,

    SUM(COALESCE(API_ACCEPT_ON_US_REFER_APPLICATION_DECLINE_COUNT, 0))
        AS API_ACCEPT_ON_US_REFER_APP_DECLINE,

    SUM(COALESCE(API_ACCEPT_ON_US_DECLINE_APPLICATION_DECLINE_COUNT, 0))
        AS API_ACCEPT_ON_US_DECLINE_APP_DECLINE,

    SUM(COALESCE(DIRECT_ON_US_ACCEPT_APPLICATION_DECLINE_COUNT, 0))
        AS DIRECT_ON_US_ACCEPT_APP_DECLINE,

    SUM(COALESCE(DIRECT_ON_US_REFER_APPLICATION_DECLINE_COUNT, 0))
        AS DIRECT_ON_US_REFER_APP_DECLINE,

    SUM(COALESCE(DIRECT_ON_US_DECLINE_APPLICATION_DECLINE_COUNT, 0))
        AS DIRECT_ON_US_DECLINE_APP_DECLINE

FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY
WHERE APPLICATION_DECISION_DATE >= DATE '2026-09-01'
  AND APPLICATION_DECISION_DATE <  DATE '2026-10-01';