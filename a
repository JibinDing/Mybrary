SELECT
    APPLICATION_NUMBER,
    AUDIT_DATE,
    QUOTE_STATUS_CODE,
    COUNT(*) AS RECORD_COUNT
FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME
WHERE APPLICATION_NUMBER IN (
    '378754715',
    '378756513'
)
GROUP BY
    APPLICATION_NUMBER,
    AUDIT_DATE,
    QUOTE_STATUS_CODE
ORDER BY
    APPLICATION_NUMBER,
    AUDIT_DATE,
    QUOTE_STATUS_CODE;