WITH max_ts AS (
    SELECT
        TRANSACTION_IDENTIFIER,
        MAX(SOURCE_CHANGE_TIMESTAMP) AS MAX_SOURCE_CHANGE_TIMESTAMP
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS
    WHERE SOURCE_CHANGE_TIMESTAMP >= '2026-09-09 01:00:00'
    GROUP BY TRANSACTION_IDENTIFIER
),

latest_tied_rows AS (
    SELECT
        s.TRANSACTION_IDENTIFIER,
        s.SOURCE_CHANGE_TIMESTAMP,
        s.TRANSACTION_STATUS_CODE,

        CASE
            WHEN s.TRANSACTION_STATUS_CODE IN (
                'DUPLICATE_POSTED_TRAN',
                'GATHER_BROWSER_INFO',
                'VALIDATION_FAILED',
                'DIARY_NOTE_MADE'
            )
            THEN 'EXCLUDED'
            ELSE 'INCLUDED'
        END AS INCLUSION_FLAG

    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS s

    JOIN max_ts m
      ON s.TRANSACTION_IDENTIFIER = m.TRANSACTION_IDENTIFIER
     AND s.SOURCE_CHANGE_TIMESTAMP = m.MAX_SOURCE_CHANGE_TIMESTAMP
),

mixed_transactions AS (
    SELECT
        TRANSACTION_IDENTIFIER,
        SOURCE_CHANGE_TIMESTAMP,
        COUNT(*) AS ROW_COUNT,
        COUNT(DISTINCT TRANSACTION_STATUS_CODE) AS STATUS_COUNT,
        COUNT(DISTINCT INCLUSION_FLAG) AS INCLUSION_FLAG_COUNT
    FROM latest_tied_rows
    GROUP BY
        TRANSACTION_IDENTIFIER,
        SOURCE_CHANGE_TIMESTAMP
    HAVING COUNT(*) > 1
       AND COUNT(DISTINCT INCLUSION_FLAG) > 1
)

SELECT
    COUNT(*) AS TIED_TXNS_WITH_MIXED_INCLUSION
FROM mixed_transactions;