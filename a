WITH DAILY_CHECK AS (
    SELECT
        APPLICATION_DECISION_DATE,

        SUM(COALESCE(API_ACCEPT_ON_US_CHECK_COUNT, 0))
            AS AGGREGATOR_ON_US_ELIGIBILITY,

        SUM(COALESCE(API_ACCEPT_ON_US_ACCEPT_COUNT, 0))
            AS ON_US_ACCEPTED,

        SUM(COALESCE(API_ACCEPT_ON_US_REFER_COUNT, 0))
            AS ON_US_REFERRED,

        SUM(COALESCE(API_ACCEPT_ON_US_DECLINE_COUNT, 0))
            AS ON_US_DECLINED

    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

    WHERE APPLICATION_DECISION_DATE IS NOT NULL

    GROUP BY APPLICATION_DECISION_DATE
)

SELECT
    APPLICATION_DECISION_DATE,

    AGGREGATOR_ON_US_ELIGIBILITY,
    ON_US_ACCEPTED,
    ON_US_REFERRED,
    ON_US_DECLINED,

    ON_US_ACCEPTED
      + ON_US_REFERRED
      + ON_US_DECLINED
        AS CALCULATED_ON_US_TOTAL,

    AGGREGATOR_ON_US_ELIGIBILITY
      - (
            ON_US_ACCEPTED
          + ON_US_REFERRED
          + ON_US_DECLINED
        ) AS DIFFERENCE,

    CASE
        WHEN AGGREGATOR_ON_US_ELIGIBILITY =
             ON_US_ACCEPTED
           + ON_US_REFERRED
           + ON_US_DECLINED
        THEN 'PASS'
        ELSE 'FAIL'
    END AS TEST_RESULT

FROM DAILY_CHECK

ORDER BY APPLICATION_DECISION_DATE DESC;