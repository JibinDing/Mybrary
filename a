, COMPLETE_OPEN_GROUPS AS (
    SELECT
        LINKED_APPLICATION_NUMBER
    FROM BASE
    GROUP BY LINKED_APPLICATION_NUMBER
    HAVING
        COUNT(DISTINCT CASE
            WHEN UPPER(TRIM(FULL_APPLICATION_STATUS_CODE)) = 'COMPLETE'
            THEN APPLICATION_IDENTIFIER
        END) > 0

        AND COUNT(DISTINCT CASE
            WHEN UPPER(TRIM(FULL_APPLICATION_STATUS_CODE)) = 'OPEN'
            THEN APPLICATION_IDENTIFIER
        END) > 0

        AND COUNT(DISTINCT CASE
            WHEN UPPER(TRIM(FULL_APPLICATION_STATUS_CODE))
                 NOT IN ('COMPLETE', 'OPEN', 'WITHDRAWN')
            THEN APPLICATION_IDENTIFIER
        END) = 0
)

SELECT
    COMPLETE_APP_COUNT,
    COUNT(*) AS GROUP_COUNT
FROM (
    SELECT
        B.LINKED_APPLICATION_NUMBER,
        COUNT(DISTINCT CASE
            WHEN UPPER(TRIM(B.FULL_APPLICATION_STATUS_CODE)) = 'COMPLETE'
            THEN B.APPLICATION_IDENTIFIER
        END) AS COMPLETE_APP_COUNT
    FROM BASE B
    JOIN COMPLETE_OPEN_GROUPS C
      ON B.LINKED_APPLICATION_NUMBER = C.LINKED_APPLICATION_NUMBER
    GROUP BY B.LINKED_APPLICATION_NUMBER
)
GROUP BY COMPLETE_APP_COUNT
ORDER BY COMPLETE_APP_COUNT;