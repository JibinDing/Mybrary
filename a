SELECT
    COUNT(*) AS TOTAL_ROWS,
    COUNT_IF(
        AUDIT_DATE >= '2026-09-01'
        AND AUDIT_DATE < '2026-10-01'
    ) AS SEPTEMBER_ROWS,
    COUNT_IF(
        AUDIT_DATE >= '2026-09-01'
        AND AUDIT_DATE < '2026-10-01'
        AND QUOTE_STATUS_CODE IN ('F', '+')
    ) AS SEPTEMBER_FULL_APPLICATION_ROWS
FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME;