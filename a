WITH sep9_txns AS (
    SELECT DISTINCT TRANSACTION_IDENTIFIER
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS
    WHERE SOURCE_CHANGE_TIMESTAMP >= '2026-09-09 01:00:00'
      AND SOURCE_CHANGE_TIMESTAMP <  '2026-09-10 00:00:00'
),

latest_status AS (
    SELECT
        s.TRANSACTION_IDENTIFIER,
        s.TRANSACTION_STATUS_CODE,
        s.SOURCE_CHANGE_TIMESTAMP,
        s.SOURCE_INSERT_TIMESTAMP,
        s.DW_LOD_TMP
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS s
    JOIN sep9_txns t
      ON s.TRANSACTION_IDENTIFIER = t.TRANSACTION_IDENTIFIER
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY s.TRANSACTION_IDENTIFIER
        ORDER BY s.SOURCE_CHANGE_TIMESTAMP DESC
    ) = 1
)

SELECT
    CAST(SOURCE_CHANGE_TIMESTAMP AS DATE) AS LATEST_STATUS_DATE,
    CAST(DW_LOD_TMP AS DATE) AS FDP_LOAD_DATE,
    COUNT(*) AS TRANSACTION_COUNT
FROM latest_status
WHERE SOURCE_CHANGE_TIMESTAMP >= '2026-09-10 00:00:00'
GROUP BY 1,2
ORDER BY 1,2;