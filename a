SELECT
    COUNT(DISTINCT APP.APPLICATION_IDENTIFIER) AS POTENTIAL_APPLICATIONS,
    MIN(CSE.CASE_CREATION_DATE) AS EARLIEST_CASE_DATE,
    MAX(CSE.CASE_CREATION_DATE) AS LATEST_CASE_DATE
FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION APP
JOIN FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE CSE
    ON APP.APPLICATION_IDENTIFIER = CSE.APPLICATION_IDENTIFIER
JOIN FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME D
    ON APP.APPLICATION_IDENTIFIER = D.APPLICATION_IDENTIFIER
WHERE APP.ACTIVE = '1'
  AND CSE.ACTIVE = '1'
  AND CSE.CASE_TYPE = 'PRODUCTAPP'
  AND D.QUOTE_STATUS_CODE = 'F'
  AND CSE.CASE_CREATION_DATE >= '2026-01-01'
  AND CSE.CASE_CREATION_DATE < '2026-01-25';