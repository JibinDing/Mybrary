WITH SEP_FULL_APPLICATIONS AS (
    SELECT
        APP.APPLICATION_IDENTIFIER,
        APP.LINKED_APPLICATION_NUMBER

    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION APP

    WHERE APP.ACTIVE = '1'
      AND APP.LINKED_APPLICATION_NUMBER IS NOT NULL

      AND APP.APPLICATION_APPROVAL_DATE >= DATE '2026-09-01'
      AND APP.APPLICATION_APPROVAL_DATE < DATE '2026-10-01'

      AND EXISTS (
          SELECT 1
          FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE CSE
          WHERE CSE.APPLICATION_IDENTIFIER = APP.APPLICATION_IDENTIFIER
            AND CSE.ACTIVE = '1'
            AND CSE.CASE_TYPE = 'PRODUCTAPP'
            AND CSE.CASE_CREATION_DATE >= DATE '2026-09-01'
            AND CSE.CASE_CREATION_DATE < DATE '2026-10-01'
      )

      AND EXISTS (
          SELECT 1
          FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME D
          WHERE D.APPLICATION_IDENTIFIER = APP.APPLICATION_IDENTIFIER
            AND UPPER(TRIM(D.QUOTE_STATUS_CODE)) = 'F'
      )
),

DUPLICATE_GROUPS AS (
    SELECT
        LINKED_APPLICATION_NUMBER,
        COUNT(DISTINCT APPLICATION_IDENTIFIER) AS APPLICATION_COUNT

    FROM SEP_FULL_APPLICATIONS

    GROUP BY LINKED_APPLICATION_NUMBER

    HAVING COUNT(DISTINCT APPLICATION_IDENTIFIER) > 1
)

SELECT
    COUNT(*) AS DUPLICATE_LINKED_GROUPS,

    COALESCE(SUM(APPLICATION_COUNT), 0)
        AS APPLICATIONS_IN_DUPLICATE_GROUPS,

    COALESCE(SUM(APPLICATION_COUNT - 1), 0)
        AS POTENTIAL_APPLICATIONS_REMOVED

FROM DUPLICATE_GROUPS;