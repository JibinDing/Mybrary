
WITH TARGET_APPS AS (
    SELECT
        APPLICATION_ID,
        CREATED_DATE,
        DECISION_DATE,
        APPLICATION_STATUS_CODE,
        INTERNET_MEDIA_CODE,
        BINTRACKER,
        MP_PREAPPIND
    FROM A_UKC_CASMART_DB.APPLICATION
    WHERE CREATED_DATE >= '2026-09-05'
      AND CREATED_DATE < '2026-09-06'
      AND DECISION_DATE >= '2026-09-01'
      AND DECISION_DATE < '2026-10-01'
),

SDS_SORT AS (
    SELECT
        A.APPLICATION_ID,
        A.AUDIT_TIMESTAMP,
        A.SDS_COUNTER,
        B.CUST_TYPE_CC_BEHAV_SCRE_AVBLE
            AS RE_PROCESSED_FLAG,

        RANK() OVER (
            PARTITION BY A.APPLICATION_ID
            ORDER BY
                A.QUOTATION_INDICATOR DESC,
                B.SDS_COUNTER_MI
        ) AS PASS_ORDER,

        RANK() OVER (
            PARTITION BY A.APPLICATION_ID
            ORDER BY
                A.QUOTATION_INDICATOR,
                B.SDS_COUNTER_MI DESC
        ) AS LAST_PASS

    FROM E_CASMART_BASE.IF023_APPLICATION A
    JOIN E_CASMART_BASE.IF023_RESULTS1 B
      ON A.APPLICATION_ID = B.APPLICATION_ID
     AND A.AUDIT_TIMESTAMP = B.AUDIT_TIMESTAMP
     AND A.SDS_COUNTER = B.SDS_COUNTER

    WHERE A.AUDIT_DATE >= '2026-09-01'
      AND B.AUDIT_DATE >= '2026-09-01'
      AND EXISTS (
          SELECT 1
          FROM TARGET_APPS T
          WHERE T.APPLICATION_ID = A.APPLICATION_ID
      )
),

SDSAPP AS (
    SELECT
        X.APPLICATION_ID,
        X.AUDIT_TIMESTAMP,
        X.SDS_COUNTER,
        X.RE_PROCESSED_FLAG,
        A.TRIUMPH_PRODUCT_NO_LABEL
            AS TRIUMPH_PROD_NO,
        A.DOWNSELL0_INITIAL_FLAG
            AS DMI_INDICATOR

    FROM E_CASMART_BASE.IF023_APPLICATION A
    JOIN SDS_SORT X
      ON X.APPLICATION_ID = A.APPLICATION_ID
     AND X.AUDIT_TIMESTAMP = A.AUDIT_TIMESTAMP
     AND X.SDS_COUNTER = A.SDS_COUNTER

    WHERE A.AUDIT_DATE >= '2026-09-01'
      AND X.LAST_PASS = 1
),

SDSSUM AS (
    SELECT
        X.*,
        S.PROD_1_DMI_CODE AS DMI_CODE

    FROM E_CASMART_BASE.IF023_SUMMARY S
    JOIN SDSAPP X
      ON X.APPLICATION_ID = S.APPLICATION_ID
     AND X.AUDIT_TIMESTAMP = S.AUDIT_TIMESTAMP
     AND X.SDS_COUNTER = S.SDS_COUNTER

    WHERE S.AUDIT_DATE >= '2026-09-01'
),

LEGACY_APPS AS (
    SELECT
        S.APPLICATION_ID,
        T.CREATED_DATE,
        T.DECISION_DATE AS DEC_DATE,
        T.APPLICATION_STATUS_CODE,
        T.INTERNET_MEDIA_CODE AS TRACKING_CODE,
        T.BINTRACKER,
        T.MP_PREAPPIND,
        S.AUDIT_TIMESTAMP,
        S.SDS_COUNTER,
        S.RE_PROCESSED_FLAG,
        S.TRIUMPH_PROD_NO,
        S.DMI_INDICATOR,
        S.DMI_CODE

    FROM TARGET_APPS T
    JOIN SDSSUM S
      ON T.APPLICATION_ID = S.APPLICATION_ID
)

SELECT
    *,
    COUNT(*) OVER (
        PARTITION BY APPLICATION_ID
    ) AS ROWS_PER_APPLICATION_ID,
    COUNT(*) OVER () AS TOTAL_OUTPUT_ROWS

FROM LEGACY_APPS
ORDER BY APPLICATION_ID, AUDIT_TIMESTAMP, SDS_COUNTER;
