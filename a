WITH CUSTOMER_INDICATOR_CHECK AS (
    SELECT
        COALESCE(
            NULLIF(TRIM(BARCLAYS_CUSTOMER_INDICATOR), ''),
            'NULL / BLANK'
        ) AS BARCLAYS_CUSTOMER_INDICATOR,

        COUNT(*) AS RECORD_COUNT,

        SUM(COALESCE(APPLICATION_COUNT, 0)) AS APPLICATION_COUNT

    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

    GROUP BY 1
)

SELECT
    BARCLAYS_CUSTOMER_INDICATOR,
    RECORD_COUNT,
    APPLICATION_COUNT,

    CASE
        WHEN BARCLAYS_CUSTOMER_INDICATOR IN ('Y', 'N')
            THEN 'PASS'

        WHEN BARCLAYS_CUSTOMER_INDICATOR = 'NULL / BLANK'
            THEN 'REVIEW'

        ELSE 'FAIL'
    END AS TEST_RESULT

FROM CUSTOMER_INDICATOR_CHECK

ORDER BY RECORD_COUNT DESC;




