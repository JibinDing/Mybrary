WITH DAILY_CHECK AS (
    SELECT
        APPLICATION_DECISION_DATE,

        SUM(
            COALESCE(API_ACCEPT_ON_US_ACCEPT_APPLICATION_ACCEPT_COUNT, 0)
        ) AS ON_US_ACCEPT_APP_ACCEPTED,

        SUM(
            COALESCE(API_ACCEPT_ON_US_REFER_APPLICATION_ACCEPT_COUNT, 0)
        ) AS ON_US_REFER_APP_ACCEPTED,

        SUM(
            COALESCE(API_ACCEPT_ON_US_DECLINE_APPLICATION_ACCEPT_COUNT, 0)
        ) AS ON_US_DECLINE_APP_ACCEPTED

    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

    WHERE APPLICATION_DECISION_DATE IS NOT NULL

    GROUP BY APPLICATION_DECISION_DATE
)

SELECT
    APPLICATION_DECISION_DATE,

    ON_US_ACCEPT_APP_ACCEPTED,
    ON_US_REFER_APP_ACCEPTED,
    ON_US_DECLINE_APP_ACCEPTED,

    ON_US_ACCEPT_APP_ACCEPTED
      + ON_US_REFER_APP_ACCEPTED
      + ON_US_DECLINE_APP_ACCEPTED
        AS AGGREGATOR_ON_US_CONVERSION,

    CASE
        WHEN ON_US_ACCEPT_APP_ACCEPTED
           + ON_US_REFER_APP_ACCEPTED
           + ON_US_DECLINE_APP_ACCEPTED >= 0
        THEN 'PASS'
        ELSE 'FAIL'
    END AS TEST_RESULT

FROM DAILY_CHECK

ORDER BY APPLICATION_DECISION_DATE DESC;