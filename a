SELECT
    APPLICATION_NUMBER,
    APPLICATION_IDENTIFIER,
    AUDIT_DATE,
    AUDIT_TIMESTAMP,
    SDS_COUNTER,
    APPLICATION_CHANNEL_CODE
FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME
WHERE APPLICATION_NUMBER IN (
    '378754715',
    '378756513'
)
ORDER BY
    APPLICATION_NUMBER,
    AUDIT_TIMESTAMP,
    SDS_COUNTER;