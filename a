WITH TARGET_APPS AS (
    SELECT DISTINCT
        APPLICATION_NUMBER,
        APPLICATION_IDENTIFIER
    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME
    WHERE APPLICATION_NUMBER IN (
        '378754715',
        '378756513'
    )
)

SELECT
    D.APPLICATION_NUMBER,
    A.APPLICATION_IDENTIFIER,
    A.LINKED_APPLICATION_NUMBER,
    A.ACTIVE AS APP_ACTIVE,
    A.EFF_START_DATE,
    A.APPLICATION_APPROVAL_DATE,
    A.APPROVAL_TIMESTAMP

FROM TARGET_APPS D

JOIN FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION A
    ON D.APPLICATION_IDENTIFIER = A.APPLICATION_IDENTIFIER

ORDER BY
    D.APPLICATION_NUMBER,
    A.EFF_START_DATE DESC;