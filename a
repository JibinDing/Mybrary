WITH OLD AS (
    SELECT
        UPPER(TRIM(CHANNEL_LEVEL_3)) AS CHANNEL_LEVEL_3,
        UPPER(TRIM(ACQUISITION_SEGMENT2)) AS PRODUCT_NAME,
        REQUESTED_PRODUCT_DMI_CODE,
        OFFERED_PRODUCT_DMI_CODE,
        SUM(QUOTE_TO_APPLICATION) AS OLD_COUNT
    FROM BDP_UK_CARDS.CARDS_AGGREGATOR_MULTIQUOTE
    WHERE APPLICATION_CREATED_DATE = '2026-08-01'
      AND CHANNEL_LEVEL_1 = '3rd Parties'
      AND CHANNEL_LEVEL_2 = 'Aggs'
    GROUP BY 1,2,3,4
),

NEW AS (
    SELECT
        UPPER(TRIM(LEVEL_3_CHANNEL_NAME)) AS CHANNEL_LEVEL_3,
        UPPER(TRIM(ACQUISITION_PRODUCT_NAME)) AS PRODUCT_NAME,
        REQUESTED_PRODUCT_DMI_CODE,
        OFFERED_PRODUCT_DMI_CODE,
        SUM(APPLICATION_COUNT) AS NEW_COUNT
    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY
    WHERE APPLICATION_CREATED_DATE = '2026-08-01'
      AND LEVEL_1_CHANNEL_NAME = '3rd Parties'
      AND LEVEL_2_CHANNEL_NAME = 'Aggs'
    GROUP BY 1,2,3,4
)

SELECT
    COALESCE(O.CHANNEL_LEVEL_3, N.CHANNEL_LEVEL_3) AS CHANNEL_LEVEL_3,
    COALESCE(O.PRODUCT_NAME, N.PRODUCT_NAME) AS PRODUCT_NAME,
    COALESCE(O.REQUESTED_PRODUCT_DMI_CODE, N.REQUESTED_PRODUCT_DMI_CODE)
        AS REQUESTED_PRODUCT_DMI_CODE,
    COALESCE(O.OFFERED_PRODUCT_DMI_CODE, N.OFFERED_PRODUCT_DMI_CODE)
        AS OFFERED_PRODUCT_DMI_CODE,
    COALESCE(O.OLD_COUNT, 0) AS OLD_COUNT,
    COALESCE(N.NEW_COUNT, 0) AS NEW_COUNT,
    COALESCE(N.NEW_COUNT, 0) - COALESCE(O.OLD_COUNT, 0) AS DIFFERENCE
FROM OLD O
FULL OUTER JOIN NEW N
    ON O.CHANNEL_LEVEL_3 = N.CHANNEL_LEVEL_3
   AND O.PRODUCT_NAME = N.PRODUCT_NAME
   AND COALESCE(O.REQUESTED_PRODUCT_DMI_CODE, 'NULL')
       = COALESCE(N.REQUESTED_PRODUCT_DMI_CODE, 'NULL')
   AND COALESCE(O.OFFERED_PRODUCT_DMI_CODE, 'NULL')
       = COALESCE(N.OFFERED_PRODUCT_DMI_CODE, 'NULL')
WHERE COALESCE(O.OLD_COUNT, 0) <> COALESCE(N.NEW_COUNT, 0)
ORDER BY 1,2,3,4;