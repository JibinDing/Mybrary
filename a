WITH auth AS (
    SELECT DISTINCT
        TRANSACTION_IDENTIFIER,
        TRIM(TRANSACTION_PURPOSE_CODE) AS TRANSACTION_PURPOSE_CODE
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_AUTHORIZATION_TRANSACTION
    WHERE SOURCE_INSERT_TIMESTAMP >= '2026-08-01'
      AND SOURCE_INSERT_TIMESTAMP <  '2026-10-01'
      AND TRIM(TRANSACTION_PURPOSE_CODE) IN (
          'DPNGCB',
          'NGCBRF',
          'RL_BLD',
          'RH_BLD',
          'FL_BLD',
          'FH_BLD',
          'IH_BLD',
          'IL_BLD'
      )
),

status AS (
    SELECT DISTINCT TRANSACTION_IDENTIFIER
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS
)

SELECT
    a.TRANSACTION_PURPOSE_CODE,
    COUNT(*) AS TOTAL_AUTH_TRANSACTIONS,
    COUNT_IF(s.TRANSACTION_IDENTIFIER IS NULL) AS AUTH_WITHOUT_STATUS,
    COUNT_IF(s.TRANSACTION_IDENTIFIER IS NOT NULL) AS AUTH_WITH_STATUS,
    ROUND(
        100.0 * COUNT_IF(s.TRANSACTION_IDENTIFIER IS NULL)
        / NULLIF(COUNT(*), 0),
        2
    ) AS WITHOUT_STATUS_PCT
FROM auth a
LEFT JOIN status s
    ON a.TRANSACTION_IDENTIFIER = s.TRANSACTION_IDENTIFIER
GROUP BY a.TRANSACTION_PURPOSE_CODE
ORDER BY AUTH_WITHOUT_STATUS DESC;