SELECT
    COALESCE(FULL_APPLICATION_STATUS_CODE, 'NULL') AS DECISION_STATUS,
    SUM(COALESCE(APPLICATION_COUNT, 0)) AS APPLICATION_VOLUME
FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY
WHERE APPLICATION_DECISION_DATE >= DATE '2026-09-01'
  AND APPLICATION_DECISION_DATE <  DATE '2026-10-01'
GROUP BY COALESCE(FULL_APPLICATION_STATUS_CODE, 'NULL')
ORDER BY APPLICATION_VOLUME DESC;