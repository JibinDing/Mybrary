WITH DEDUP_CHECK AS (
    SELECT
        APP.APPLICATION_IDENTIFIER,
        APP.LINKED_APPLICATION_NUMBER,
        CSE.CASE_STATUS_CODE,
        CSE.CASE_CREATION_DATE,

        ROW_NUMBER() OVER (
            PARTITION BY APP.LINKED_APPLICATION_NUMBER
            ORDER BY
                CASE
                    WHEN UPPER(TRIM(CSE.CASE_STATUS_CODE)) = 'COMPLETE' THEN 1
                    WHEN UPPER(TRIM(CSE.CASE_STATUS_CODE)) <> 'WITHDRAWN' THEN 2
                    ELSE 3
                END,
                APP.APPLICATION_IDENTIFIER DESC
        ) AS RN

    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION APP

    JOIN FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE CSE
        ON APP.APPLICATION_IDENTIFIER = CSE.APPLICATION_IDENTIFIER

    WHERE APP.ACTIVE = '1'
      AND CSE.ACTIVE = '1'
      AND CSE.CASE_TYPE = 'PRODUCTAPP'
      AND APP.LINKED_APPLICATION_NUMBER = '378754715'
      AND CSE.CASE_CREATION_DATE >= '2026-07-28'
      AND CSE.CASE_CREATION_DATE < '2026-10-27'
)

SELECT *,
    CASE
        WHEN RN = 1 THEN 'SELECTED'
        ELSE 'REMOVED'
    END AS DEDUP_RESULT
FROM DEDUP_CHECK
ORDER BY RN;