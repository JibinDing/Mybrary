WITH BASE AS (
    SELECT
        APP.APPLICATION_IDENTIFIER,
        APP.LINKED_APPLICATION_NUMBER,
        UPPER(TRIM(CSE.CASE_STATUS_CODE)) AS FULL_APPLICATION_STATUS_CODE
    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION APP
    JOIN FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE CSE
        ON APP.APPLICATION_IDENTIFIER = CSE.APPLICATION_IDENTIFIER
    WHERE APP.ACTIVE = '1'
      AND CSE.ACTIVE = '1'
      AND CSE.CASE_TYPE = 'PRODUCTAPP'

      AND APP.APPLICATION_APPROVAL_DATE >= DATE '2026-09-01'
      AND APP.APPLICATION_APPROVAL_DATE <  DATE '2026-10-01'

      AND EXISTS (
          SELECT 1
          FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME D
          WHERE D.APPLICATION_IDENTIFIER = APP.APPLICATION_IDENTIFIER
            AND D.QUOTE_STATUS_CODE = 'F'
      )
),

DEDUP AS (
    SELECT
        *,
        ROW_NUMBER() OVER (
            PARTITION BY
                CASE
                    WHEN LINKED_APPLICATION_NUMBER IS NOT NULL
                    THEN 'L|' || LINKED_APPLICATION_NUMBER
                    ELSE 'A|' || APPLICATION_IDENTIFIER
                END
            ORDER BY
                CASE
                    WHEN FULL_APPLICATION_STATUS_CODE = 'COMPLETE' THEN 1
                    WHEN FULL_APPLICATION_STATUS_CODE <> 'WITHDRAWN' THEN 2
                    ELSE 3
                END,
                APPLICATION_IDENTIFIER DESC
        ) AS RN
    FROM BASE
),

RESULT AS (
    SELECT
        FULL_APPLICATION_STATUS_CODE,
        COUNT(*) AS APPLICATION_VOLUME
    FROM DEDUP
    WHERE RN = 1
    GROUP BY FULL_APPLICATION_STATUS_CODE
)

SELECT
    FULL_APPLICATION_STATUS_CODE,
    APPLICATION_VOLUME
FROM RESULT

UNION ALL

SELECT
    'TOTAL' AS FULL_APPLICATION_STATUS_CODE,
    SUM(APPLICATION_VOLUME) AS APPLICATION_VOLUME
FROM RESULT

ORDER BY
    CASE WHEN FULL_APPLICATION_STATUS_CODE = 'TOTAL' THEN 2 ELSE 1 END,
    APPLICATION_VOLUME DESC;