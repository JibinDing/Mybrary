WITH DAILY_CHECK AS (
    SELECT
        APPLICATION_DECISION_DATE,

        SUM(COALESCE(DIRECT_ON_US_CHECK_COUNT, 0))
            AS DIRECT_ON_US_ELIGIBILITY,

        SUM(COALESCE(DIRECT_ON_US_ACCEPT_APPLICATION_ACCEPT_COUNT, 0))
            AS ACCEPT_TO_APP_ACCEPT,

        SUM(COALESCE(DIRECT_ON_US_REFER_APPLICATION_ACCEPT_COUNT, 0))
            AS REFER_TO_APP_ACCEPT,

        SUM(COALESCE(DIRECT_ON_US_DECLINE_APPLICATION_ACCEPT_COUNT, 0))
            AS DECLINE_TO_APP_ACCEPT

    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

    WHERE APPLICATION_DECISION_DATE IS NOT NULL

    GROUP BY APPLICATION_DECISION_DATE
),

VALIDATION AS (
    SELECT
        APPLICATION_DECISION_DATE,
        DIRECT_ON_US_ELIGIBILITY,

        ACCEPT_TO_APP_ACCEPT
        + REFER_TO_APP_ACCEPT
        + DECLINE_TO_APP_ACCEPT
            AS DIRECT_ON_US_CONVERSION

    FROM DAILY_CHECK
)

SELECT
    COUNT(*) AS DAYS_TESTED,

    COUNT_IF(
        DIRECT_ON_US_CONVERSION <= DIRECT_ON_US_ELIGIBILITY
    ) AS PASSED_DAYS,

    COUNT_IF(
        DIRECT_ON_US_CONVERSION > DIRECT_ON_US_ELIGIBILITY
    ) AS FAILED_DAYS,

    CASE
        WHEN COUNT_IF(
            DIRECT_ON_US_CONVERSION > DIRECT_ON_US_ELIGIBILITY
        ) = 0
        THEN 'PASS'
        ELSE 'FAIL'
    END AS OVERALL_RESULT

FROM VALIDATION;