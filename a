, MULTI_NON_WITHDRAWN AS (
    SELECT
        LINKED_APPLICATION_NUMBER
    FROM BASE
    GROUP BY LINKED_APPLICATION_NUMBER
    HAVING COUNT(DISTINCT APPLICATION_IDENTIFIER) > 1
       AND COUNT(DISTINCT CASE
               WHEN UPPER(TRIM(FULL_APPLICATION_STATUS_CODE)) <> 'WITHDRAWN'
               THEN APPLICATION_IDENTIFIER
           END) > 1
),

COMPLETE_GROUPS AS (
    SELECT
        B.LINKED_APPLICATION_NUMBER
    FROM BASE B
    JOIN MULTI_NON_WITHDRAWN M
      ON B.LINKED_APPLICATION_NUMBER = M.LINKED_APPLICATION_NUMBER
    GROUP BY B.LINKED_APPLICATION_NUMBER
    HAVING MAX(
        CASE
            WHEN UPPER(TRIM(B.FULL_APPLICATION_STATUS_CODE)) = 'COMPLETE'
            THEN 1 ELSE 0
        END
    ) = 1
)

SELECT
    UPPER(TRIM(B.FULL_APPLICATION_STATUS_CODE)) AS LATEST_STATUS,
    COUNT(*) AS GROUP_COUNT
FROM BASE B
JOIN COMPLETE_GROUPS C
  ON B.LINKED_APPLICATION_NUMBER = C.LINKED_APPLICATION_NUMBER
WHERE B.LATEST_APP_RN = 1
GROUP BY 1
ORDER BY 2 DESC;



