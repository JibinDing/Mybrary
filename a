SELECT
    APPLICATION_IDENTIFIER,
    QUOTE_STATUS_CODE,
    COUNT(*) AS RECORD_COUNT,
    MIN(AUDIT_DATE) AS FIRST_AUDIT_DATE,
    MAX(AUDIT_DATE) AS LAST_AUDIT_DATE
FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME
WHERE RIGHT(TRIM(TO_VARCHAR(APPLICATION_IDENTIFIER)), 9)
      IN ('378554328', '378611926')
  AND AUDIT_DATE >= '2026-09-01'
  AND AUDIT_DATE < '2026-10-01'
GROUP BY
    APPLICATION_IDENTIFIER,
    QUOTE_STATUS_CODE
ORDER BY
    APPLICATION_IDENTIFIER,
    QUOTE_STATUS_CODE;