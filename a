, LINKED_ANALYSIS AS (
    SELECT
        LINKED_APPLICATION_NUMBER,

        COUNT(DISTINCT APPLICATION_IDENTIFIER) AS TOTAL_APP_COUNT,

        COUNT(DISTINCT CASE
            WHEN UPPER(TRIM(FULL_APPLICATION_STATUS_CODE)) = 'WITHDRAWN'
            THEN APPLICATION_IDENTIFIER
        END) AS WITHDRAWN_APP_COUNT,

        COUNT(DISTINCT CASE
            WHEN UPPER(TRIM(FULL_APPLICATION_STATUS_CODE)) <> 'WITHDRAWN'
            THEN APPLICATION_IDENTIFIER
        END) AS NON_WITHDRAWN_APP_COUNT

    FROM BASE
    GROUP BY LINKED_APPLICATION_NUMBER

    HAVING COUNT(DISTINCT APPLICATION_IDENTIFIER) > 1
)

SELECT
    CASE
        WHEN NON_WITHDRAWN_APP_COUNT = 0
            THEN 'ALL WITHDRAWN'

        WHEN NON_WITHDRAWN_APP_COUNT = 1
            THEN 'ONE NON-WITHDRAWN'

        ELSE 'MULTIPLE NON-WITHDRAWN'
    END AS SCENARIO,

    COUNT(*) AS LINKED_APPLICATION_GROUPS

FROM LINKED_ANALYSIS
GROUP BY 1
ORDER BY 1;