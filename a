WITH OLD AS (
    SELECT
        CHANNEL_LEVEL_2,
        SUM(QUOTE_TO_APPLICATION) AS OLD_COUNT
    FROM BDP_UK_CARDS.CARDS_AGGREGATOR_MULTIQUOTE
    WHERE APPLICATION_CREATED_DATE = '2026-08-01'
      AND CHANNEL_LEVEL_1 = '3rd Parties'
    GROUP BY 1
),

NEW AS (
    SELECT
        LEVEL_2_CHANNEL_NAME,
        SUM(APPLICATION_COUNT) AS NEW_COUNT
    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY
    WHERE APPLICATION_CREATED_DATE = '2026-08-01'
      AND LEVEL_1_CHANNEL_NAME = '3rd Parties'
    GROUP BY 1
)

SELECT
    COALESCE(O.CHANNEL_LEVEL_2, N.LEVEL_2_CHANNEL_NAME) AS CHANNEL_LEVEL_2,
    COALESCE(O.OLD_COUNT, 0) AS OLD_COUNT,
    COALESCE(N.NEW_COUNT, 0) AS NEW_COUNT,
    COALESCE(N.NEW_COUNT, 0) - COALESCE(O.OLD_COUNT, 0) AS DIFFERENCE
FROM OLD O
FULL OUTER JOIN NEW N
    ON COALESCE(O.CHANNEL_LEVEL_2, 'NULL')
     = COALESCE(N.LEVEL_2_CHANNEL_NAME, 'NULL')
WHERE COALESCE(O.OLD_COUNT, 0) <> COALESCE(N.NEW_COUNT, 0);