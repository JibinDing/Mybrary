WITH x AS (
    SELECT
        p.*,
        c.*,
        ROW_NUMBER() OVER (
            PARTITION BY p.id
            ORDER BY p.decisiondate DESC
        ) AS rn
    FROM E_CASMART_BASE.IF110_VEC_PRODUCTAPP p
    JOIN E_CASMART_BASE.IF110_VEC_CASE c
      ON p.id = c.id
    WHERE p.decisiondate = '2026-08-18'
      AND c.status = 'COMPLETE'
)
SELECT *
FROM x
WHERE rn = 1;


