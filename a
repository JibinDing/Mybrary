SELECT
    'CUSTOMER_COOKIE_FUNCTIONAL_INDICATOR' AS INDICATOR_NAME,
    COALESCE(UPPER(TRIM(CUSTOMER_COOKIE_FUNCTIONAL_INDICATOR)), 'NULL') AS INDICATOR_VALUE,
    COUNT(*) AS RECORD_COUNT
FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_INDICATOR
GROUP BY 1, 2

UNION ALL

SELECT
    'CUSTOMER_COOKIE_PERFORMANCE_INDICATOR',
    COALESCE(UPPER(TRIM(CUSTOMER_COOKIE_PERFORMANCE_INDICATOR)), 'NULL'),
    COUNT(*)
FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_INDICATOR
GROUP BY 1, 2

UNION ALL

SELECT
    'CUSTOMER_COOKIE_TARGET_INDICATOR',
    COALESCE(UPPER(TRIM(CUSTOMER_COOKIE_TARGET_INDICATOR)), 'NULL'),
    COUNT(*)
FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_INDICATOR
GROUP BY 1, 2

UNION ALL

SELECT
    'PHONE_MARKETING_INDICATOR',
    COALESCE(UPPER(TRIM(PHONE_MARKETING_INDICATOR)), 'NULL'),
    COUNT(*)
FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_INDICATOR
GROUP BY 1, 2

UNION ALL

SELECT
    'POST_MARKETING_INDICATOR',
    COALESCE(UPPER(TRIM(POST_MARKETING_INDICATOR)), 'NULL'),
    COUNT(*)
FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_INDICATOR
GROUP BY 1, 2

ORDER BY
    INDICATOR_NAME,
    RECORD_COUNT DESC;