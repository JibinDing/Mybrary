ROW_NUMBER() OVER (
    PARTITION BY LINKED_APPLICATION_NUMBER
    ORDER BY
        CASE
            WHEN UPPER(TRIM(CSE.CASE_STATUS_CODE)) = 'COMPLETE' THEN 1
            WHEN UPPER(TRIM(CSE.CASE_STATUS_CODE)) <> 'WITHDRAWN' THEN 2
            ELSE 3
        END,
        APP.EFF_START_DATE DESC,
        APP.APPLICATION_IDENTIFIER DESC
) AS RN