WITH ACCEPT_COUNTS AS (
    SELECT
        SUM(COALESCE(APPLICATION_ACCEPT_COUNT, 0))
            AS APPLICATION_ACCEPT_COUNT,

        SUM(
            COALESCE(API_ACCEPT_ON_US_ACCEPT_APPLICATION_ACCEPT_COUNT, 0)
          + COALESCE(API_ACCEPT_ON_US_REFER_APPLICATION_ACCEPT_COUNT, 0)
          + COALESCE(API_ACCEPT_ON_US_DECLINE_APPLICATION_ACCEPT_COUNT, 0)
        ) AS API_ACCEPT_COUNT,

        SUM(
            COALESCE(DIRECT_ON_US_ACCEPT_APPLICATION_ACCEPT_COUNT, 0)
          + COALESCE(DIRECT_ON_US_REFER_APPLICATION_ACCEPT_COUNT, 0)
          + COALESCE(DIRECT_ON_US_DECLINE_APPLICATION_ACCEPT_COUNT, 0)
        ) AS DIRECT_ACCEPT_COUNT

    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY
    WHERE APPLICATION_DECISION_DATE >= DATE '2026-09-01'
      AND APPLICATION_DECISION_DATE < DATE '2026-10-01'
)

SELECT
    APPLICATION_ACCEPT_COUNT,
    API_ACCEPT_COUNT,
    DIRECT_ACCEPT_COUNT,

    API_ACCEPT_COUNT + DIRECT_ACCEPT_COUNT
        AS CALCULATED_ACCEPT_COUNT,

    APPLICATION_ACCEPT_COUNT
        - (API_ACCEPT_COUNT + DIRECT_ACCEPT_COUNT)
        AS DIFFERENCE,

    CASE
        WHEN APPLICATION_ACCEPT_COUNT =
             API_ACCEPT_COUNT + DIRECT_ACCEPT_COUNT
        THEN 'PASS'
        ELSE 'FAIL - MISMATCH'
    END AS TEST_RESULT

FROM ACCEPT_COUNTS;