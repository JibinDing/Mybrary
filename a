WITH CASE_DATA AS (
    SELECT
        APP.APPLICATION_IDENTIFIER,
        UPPER(TRIM(CSE.CASE_STATUS_CODE)) AS CASE_STATUS
    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION APP
    JOIN FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE CSE
        ON APP.APPLICATION_IDENTIFIER = CSE.APPLICATION_IDENTIFIER
    WHERE APP.ACTIVE = '1'
      AND CSE.ACTIVE = '1'
      AND CSE.CASE_TYPE = 'PRODUCTAPP'
      AND APP.APPLICATION_APPROVAL_DATE >= DATE '2026-09-01'
      AND APP.APPLICATION_APPROVAL_DATE < DATE '2026-10-01'
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY CSE.APPLICATION_IDENTIFIER
        ORDER BY CSE.CASE_CREATION_DATE DESC
    ) = 1
),
OUTCOME_CHECK AS (
    SELECT
        APPLICATION_IDENTIFIER,
        COUNT_IF(QUOTE_STATUS_CODE = 'F') AS F_COUNT,
        COUNT_IF(QUOTE_STATUS_CODE = 'Q') AS Q_COUNT,
        COUNT(*) AS TOTAL_OUTCOMES
    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME
    WHERE APPLICATION_IDENTIFIER IN (
        SELECT APPLICATION_IDENTIFIER
        FROM CASE_DATA
        WHERE CASE_STATUS = 'DECLINE'
    )
    GROUP BY APPLICATION_IDENTIFIER
)
SELECT
    CASE
        WHEN COALESCE(O.F_COUNT, 0) > 0
            THEN 'HAS F DECISION'
        WHEN COALESCE(O.Q_COUNT, 0) > 0
            THEN 'Q ONLY - NO F'
        WHEN COALESCE(O.TOTAL_OUTCOMES, 0) > 0
            THEN 'OTHER OUTCOME - NO F'
        ELSE 'NO DECISION OUTCOME RECORD'
    END AS DECISION_RECORD_CATEGORY,
    COUNT(*) AS APPLICATION_COUNT
FROM CASE_DATA C
LEFT JOIN OUTCOME_CHECK O
    ON C.APPLICATION_IDENTIFIER = O.APPLICATION_IDENTIFIER
WHERE C.CASE_STATUS = 'DECLINE'
GROUP BY 1
ORDER BY APPLICATION_COUNT DESC;