WITH BASE AS (
    SELECT
        APP.APPLICATION_IDENTIFIER,
        APP.LINKED_APPLICATION_NUMBER,
        APP.EFF_START_DATE,
        CSE.CASE_CREATION_DATE,
        CSE.CASE_STATUS_CODE AS FULL_APPLICATION_STATUS_CODE,

        ROW_NUMBER() OVER (
            PARTITION BY APP.LINKED_APPLICATION_NUMBER
            ORDER BY APP.EFF_START_DATE DESC
        ) AS OLD_RN,

        ROW_NUMBER() OVER (
            PARTITION BY APP.LINKED_APPLICATION_NUMBER
            ORDER BY
                CASE
                    WHEN UPPER(TRIM(CSE.CASE_STATUS_CODE)) = 'COMPLETE' THEN 1
                    WHEN CSE.CASE_STATUS_CODE IS NOT NULL
                     AND UPPER(TRIM(CSE.CASE_STATUS_CODE)) <> 'WITHDRAWN' THEN 2
                    ELSE 3
                END,
                APP.EFF_START_DATE DESC,
                APP.APPLICATION_IDENTIFIER DESC
        ) AS NEW_RN

    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION APP

    JOIN (
        SELECT
            APPLICATION_IDENTIFIER,
            CASE_NUMBER,
            CASE_CREATION_DATE,
            CASE_STATUS_CODE
        FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE
        WHERE CASE_TYPE = 'PRODUCTAPP'
          AND ACTIVE = '1'
          AND CASE_CREATION_DATE >= '2026-01-01'
    ) CSE
        ON APP.APPLICATION_IDENTIFIER = CSE.APPLICATION_IDENTIFIER

    WHERE APP.LINKED_APPLICATION_NUMBER IS NOT NULL
      AND APP.ACTIVE = '1'
),

OLD_PICK AS (
    SELECT *
    FROM BASE
    WHERE OLD_RN = 1
),

NEW_PICK AS (
    SELECT *
    FROM BASE
    WHERE NEW_RN = 1
)

SELECT
    UPPER(TRIM(O.FULL_APPLICATION_STATUS_CODE)) AS OLD_STATUS,
    UPPER(TRIM(N.FULL_APPLICATION_STATUS_CODE)) AS NEW_STATUS,
    COUNT(*) AS GROUP_COUNT
FROM OLD_PICK O
JOIN NEW_PICK N
    ON O.LINKED_APPLICATION_NUMBER = N.LINKED_APPLICATION_NUMBER
WHERE O.APPLICATION_IDENTIFIER <> N.APPLICATION_IDENTIFIER
  AND O.CASE_CREATION_DATE = '2026-08-01'
GROUP BY 1,2
ORDER BY 3 DESC;