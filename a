SELECT
    COLUMN_NAME,
    DATA_TYPE
FROM PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB.INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'BDP_UK_CARDS'
  AND TABLE_NAME = 'FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY'
  AND (
        UPPER(COLUMN_NAME) LIKE '%STATUS%'
     OR UPPER(COLUMN_NAME) LIKE '%DECISION%'
     OR UPPER(COLUMN_NAME) LIKE '%OUTCOME%'
  )
ORDER BY ORDINAL_POSITION;