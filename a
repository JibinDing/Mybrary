SELECT DISTINCT
    TRY_TO_NUMBER(
        SPLIT_PART(APP.APPLICATION_IDENTIFIER, '|', -1)
    ) AS APPLICATION_ID
FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION APP
JOIN FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE CSE
    ON APP.APPLICATION_IDENTIFIER = CSE.APPLICATION_IDENTIFIER
WHERE APP.ACTIVE = '1'
  AND CSE.ACTIVE = '1'
  AND CSE.CASE_TYPE = 'PRODUCTAPP'
  AND CSE.CASE_CREATION_DATE >= '2026-09-01'
  AND CSE.CASE_CREATION_DATE < '2026-09-16'
  AND CSE.APPLICATION_APPROVAL_DATE >= '2026-09-01'
  AND CSE.APPLICATION_APPROVAL_DATE < '2026-10-01'
  AND EXISTS (
      SELECT 1
      FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME D
      WHERE D.APPLICATION_IDENTIFIER = APP.APPLICATION_IDENTIFIER
        AND D.QUOTE_STATUS_CODE IN ('F', '+')
  )
ORDER BY APPLICATION_ID;

