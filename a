(
    SUM(
        CASE
            WHEN AGGREGATOR_INDICATOR = '+'
                 AND APP_FLAG = 'Quote To App'
                 AND FULL_APPLICATION_STATUS_CODE = 'COMPLETE'
                 AND QUOTE_DECISION_CODE = 'Accept'
                 AND (
                     PRE_APPROVED_INDICATOR = 'Y'
                     OR (
                         PRE_APPROVED_INDICATOR = '+'
                         AND LINKED_APPLICATION_NUMBER IS NOT NULL
                     )
                 )
            THEN 1

            WHEN AGGREGATOR_INDICATOR IS NULL
                 AND PRE_APPROVED_INDICATOR IS NULL
                 AND LINKED_APPLICATION_NUMBER IS NOT NULL
                 AND APP_FLAG = 'Quote To App'
                 AND QUOTE_DECISION_CODE = 'Accept'
                 AND FULL_APPLICATION_STATUS_CODE = 'COMPLETE'
            THEN 1

            ELSE 0
        END
    )

    +

    SUM(
        CASE
            WHEN AGGREGATOR_INDICATOR IN ('N', '+', '')
                 AND PRE_APPROVED_INDICATOR IN ('+', '')
                 AND QUOTE_DECISION_CODE = 'Accept'
                 AND QTIND = 'F'
                 AND LINKED_APPLICATION_NUMBER IS NULL
                 AND FULL_APPLICATION_STATUS_CODE = 'COMPLETE'
            THEN 1

            WHEN AGGREGATOR_INDICATOR IS NULL
                 AND PRE_APPROVED_INDICATOR IS NULL
                 AND QUOTE_DECISION_CODE = 'Accept'
                 AND QTIND = 'F'
                 AND LINKED_APPLICATION_NUMBER IS NULL
                 AND FULL_APPLICATION_STATUS_CODE = 'COMPLETE'
            THEN 1

            ELSE 0
        END
    )
) AS APPLICATION_ACCEPT_COUNT