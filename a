SELECT
    APP.APPLICATION_IDENTIFIER,
    APP.LINKED_APPLICATION_NUMBER,
    APP.ACTIVE AS APP_ACTIVE,
    APP.EFF_START_DATE,

    CSE.CASE_TYPE,
    CSE.ACTIVE AS CASE_ACTIVE,
    CSE.CASE_STATUS_CODE,
    CSE.CASE_CREATION_DATE

FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION APP

LEFT JOIN FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE CSE
    ON APP.APPLICATION_IDENTIFIER = CSE.APPLICATION_IDENTIFIER

WHERE APP.APPLICATION_IDENTIFIER IN (
    SELECT DISTINCT APPLICATION_IDENTIFIER
    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME
    WHERE APPLICATION_NUMBER IN (
        '378754715',
        '378756513'
    )
)

ORDER BY
    APP.APPLICATION_IDENTIFIER,
    CSE.CASE_CREATION_DATE DESC;