SELECT
    ORIGIN_CHANNEL_CODE,
    ORIGIN_CODE,

    COUNT(*) AS SUMMARY_ROW_COUNT,

    SUM(COALESCE(APPLICATION_COUNT, 0))
        AS TOTAL_APPLICATION_VOLUME,

    MIN(APPLICATION_DECISION_DATE)
        AS FIRST_DECISION_DATE,

    MAX(APPLICATION_DECISION_DATE)
        AS LAST_DECISION_DATE

FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

GROUP BY
    ORIGIN_CHANNEL_CODE,
    ORIGIN_CODE

ORDER BY
    ORIGIN_CHANNEL_CODE,
    ORIGIN_CODE;