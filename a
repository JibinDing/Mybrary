SELECT
    CUSTOMER_COOKIE_FUNCTIONAL_INDICATOR,
    CUSTOMER_COOKIE_PERFORMANCE_INDICATOR,
    CUSTOMER_COOKIE_TARGET_INDICATOR,
    PHONE_MARKETING_INDICATOR,
    POST_MARKETING_INDICATOR,
    COUNT(*) AS RECORD_COUNT
FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_INDICATOR
GROUP BY
    CUSTOMER_COOKIE_FUNCTIONAL_INDICATOR,
    CUSTOMER_COOKIE_PERFORMANCE_INDICATOR,
    CUSTOMER_COOKIE_TARGET_INDICATOR,
    PHONE_MARKETING_INDICATOR,
    POST_MARKETING_INDICATOR
ORDER BY RECORD_COUNT DESC;