SELECT
    COALESCE(TO_VARCHAR(ACTIVE), 'NULL') AS ACTIVE_VALUE,
    COUNT(*) AS RECORD_COUNT,
    COUNT(DISTINCT APPLICATION_IDENTIFIER) AS DISTINCT_APPLICATIONS
FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE
WHERE CASE_TYPE = 'PRODUCTAPP'
  AND CASE_CREATION_DATE >= '2026-01-01'
  AND CASE_CREATION_DATE < '2026-01-25'
GROUP BY 1
ORDER BY RECORD_COUNT DESC;