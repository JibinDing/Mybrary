Pending


WITH VALIDATION AS (
    SELECT
        APPLICATION_DECISION_DATE,
        BANK_SCORE_ELIGIBLE_INDICATOR,
        GEN_16_BANK_RISK_SCORE,
        BARCLAYS_CUSTOMER_INDICATOR,
        APPLICATION_COUNT,

        CASE
            WHEN BANK_SCORE_ELIGIBLE_INDICATOR = 1
             AND GEN_16_BANK_RISK_SCORE IS NOT NULL
            THEN 'Y'
            ELSE 'N'
        END AS EXPECTED_CUSTOMER_INDICATOR

    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

    WHERE APPLICATION_DECISION_DATE < DATE '2026-08-01'
)

SELECT
    BANK_SCORE_ELIGIBLE_INDICATOR,
    CASE
        WHEN GEN_16_BANK_RISK_SCORE IS NULL THEN 'NULL'
        ELSE 'POPULATED'
    END AS GEN16_RISK_SCORE_STATUS,

    BARCLAYS_CUSTOMER_INDICATOR AS ACTUAL_INDICATOR,
    EXPECTED_CUSTOMER_INDICATOR,

    SUM(COALESCE(APPLICATION_COUNT, 0)) AS APPLICATION_VOLUME,

    CASE
        WHEN BARCLAYS_CUSTOMER_INDICATOR = EXPECTED_CUSTOMER_INDICATOR
        THEN 'PASS'
        ELSE 'FAIL'
    END AS TEST_RESULT

FROM VALIDATION

GROUP BY
    BANK_SCORE_ELIGIBLE_INDICATOR,
    CASE
        WHEN GEN_16_BANK_RISK_SCORE IS NULL THEN 'NULL'
        ELSE 'POPULATED'
    END,
    BARCLAYS_CUSTOMER_INDICATOR,
    EXPECTED_CUSTOMER_INDICATOR

ORDER BY
    TEST_RESULT DESC,
    APPLICATION_VOLUME DESC;