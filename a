SELECT
    COUNT(*) AS TOTAL_APPLICATIONS,

    MIN(DATEDIFF(
        'DAY',
        TRY_TO_DATE(CASE_CREATION_DATE),
        TRY_TO_DATE(APPLICATION_APPROVAL_DATE)
    )) AS MIN_DAYS,

    MAX(DATEDIFF(
        'DAY',
        TRY_TO_DATE(CASE_CREATION_DATE),
        TRY_TO_DATE(APPLICATION_APPROVAL_DATE)
    )) AS MAX_DAYS,

    AVG(DATEDIFF(
        'DAY',
        TRY_TO_DATE(CASE_CREATION_DATE),
        TRY_TO_DATE(APPLICATION_APPROVAL_DATE)
    )) AS AVG_DAYS,

    COUNT_IF(
        DATEDIFF(
            'DAY',
            TRY_TO_DATE(CASE_CREATION_DATE),
            TRY_TO_DATE(APPLICATION_APPROVAL_DATE)
        ) > 60
    ) AS OVER_60_DAYS

FROM <YOUR_APPLICATION_LEVEL_TABLE>
WHERE TRY_TO_DATE(CASE_CREATION_DATE) >= '2026-01-01'
  AND APPLICATION_APPROVAL_DATE IS NOT NULL;