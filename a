WITH smartpay_txns AS (
    SELECT DISTINCT TRANSACTION_IDENTIFIER
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_AUTHORIZATION_TRANSACTION
    WHERE TRIM(TRANSACTION_PURPOSE_CODE) IN (
        'DPNGCB','NGCBRF',
        'RL_BLD','RH_BLD','FL_BLD',
        'FH_BLD','IH_BLD','IL_BLD'
    )
),

max_ts AS (
    SELECT
        s.TRANSACTION_IDENTIFIER,
        MAX(s.SOURCE_CHANGE_TIMESTAMP) AS MAX_SOURCE_CHANGE_TIMESTAMP
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS s
    JOIN smartpay_txns a
      ON s.TRANSACTION_IDENTIFIER = a.TRANSACTION_IDENTIFIER
    WHERE s.SOURCE_CHANGE_TIMESTAMP >= '2026-09-09 01:00:00'
    GROUP BY s.TRANSACTION_IDENTIFIER
),

latest_tied_rows AS (
    SELECT
        s.TRANSACTION_IDENTIFIER,
        s.SOURCE_CHANGE_TIMESTAMP,
        s.TRANSACTION_STATUS_CODE,
        CASE
            WHEN s.TRANSACTION_STATUS_CODE IN (
                'DUPLICATE_POSTED_TRAN',
                'GATHER_BROWSER_INFO',
                'VALIDATION_FAILED',
                'DIARY_NOTE_MADE'
            )
            THEN 'EXCLUDED'
            ELSE 'INCLUDED'
        END AS INCLUSION_FLAG
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS s
    JOIN max_ts m
      ON s.TRANSACTION_IDENTIFIER = m.TRANSACTION_IDENTIFIER
     AND s.SOURCE_CHANGE_TIMESTAMP = m.MAX_SOURCE_CHANGE_TIMESTAMP
),

mixed_transactions AS (
    SELECT
        TRANSACTION_IDENTIFIER,
        SOURCE_CHANGE_TIMESTAMP
    FROM latest_tied_rows
    GROUP BY
        TRANSACTION_IDENTIFIER,
        SOURCE_CHANGE_TIMESTAMP
    HAVING COUNT(*) > 1
       AND COUNT(DISTINCT INCLUSION_FLAG) > 1
)

SELECT
    DATE_TRUNC('HOUR', SOURCE_CHANGE_TIMESTAMP) AS REPORT_HOUR,
    COUNT(*) AS AFFECTED_TRANSACTIONS
FROM mixed_transactions
GROUP BY 1
ORDER BY 1;