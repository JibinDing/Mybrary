SELECT
    COUNT(DISTINCT APP.APPLICATION_IDENTIFIER) AS ACCEPTED_APPLICATIONS
FROM PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB.FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION APP
JOIN PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB.FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE CSE
    ON CSE.APPLICATION_IDENTIFIER = APP.APPLICATION_IDENTIFIER
WHERE APP.APPLICATION_APPROVAL_DATE = '2026-08-18'
  AND CSE.CASE_TYPE = 'PRODUCTAPP'
  AND CSE.CASE_STATUS_CODE = 'COMPLETE'
  AND <accepted decision condition>;