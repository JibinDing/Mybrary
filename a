WITH CASE_DATA AS (
    SELECT
        APP.APPLICATION_IDENTIFIER,
        APP.LINKED_APPLICATION_NUMBER,
        UPPER(TRIM(CSE.CASE_STATUS_CODE)) AS CASE_STATUS
    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION APP
    JOIN FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE CSE
        ON APP.APPLICATION_IDENTIFIER = CSE.APPLICATION_IDENTIFIER
    WHERE APP.ACTIVE = '1'
      AND CSE.ACTIVE = '1'
      AND CSE.CASE_TYPE = 'PRODUCTAPP'
      AND APP.APPLICATION_APPROVAL_DATE >= DATE '2026-09-01'
      AND APP.APPLICATION_APPROVAL_DATE < DATE '2026-10-01'
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY APP.APPLICATION_IDENTIFIER
        ORDER BY CSE.CASE_CREATION_DATE DESC
    ) = 1
),

F_APPLICATIONS AS (
    SELECT DISTINCT
        APPLICATION_IDENTIFIER
    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME
    WHERE QUOTE_STATUS_CODE = 'F'
),

DEDUP AS (
    SELECT
        C.*,
        ROW_NUMBER() OVER (
            PARTITION BY
                CASE
                    WHEN C.LINKED_APPLICATION_NUMBER IS NOT NULL
                    THEN 'L:' || TO_VARCHAR(C.LINKED_APPLICATION_NUMBER)
                    ELSE 'D:' || TO_VARCHAR(C.APPLICATION_IDENTIFIER)
                END
            ORDER BY
                CASE
                    WHEN C.CASE_STATUS = 'COMPLETE' THEN 1
                    WHEN C.CASE_STATUS <> 'WITHDRAWN' THEN 2
                    ELSE 3
                END,
                C.APPLICATION_IDENTIFIER DESC
        ) AS RN
    FROM CASE_DATA C
)

SELECT
    CASE
        WHEN GROUPING(D.CASE_STATUS) = 1 THEN 'TOTAL'
        ELSE D.CASE_STATUS
    END AS CASE_STATUS,

    COUNT(*) AS BEFORE_DEDUP,

    COUNT_IF(D.RN = 1) AS AFTER_DEDUP,

    COUNT(*) - COUNT_IF(D.RN = 1) AS REMOVED_COUNT

FROM DEDUP D
JOIN F_APPLICATIONS F
    ON D.APPLICATION_IDENTIFIER = F.APPLICATION_IDENTIFIER

WHERE D.CASE_STATUS NOT IN ('COMPLETE', 'REFER')

GROUP BY ROLLUP(D.CASE_STATUS)

ORDER BY
    GROUPING(D.CASE_STATUS),
    BEFORE_DEDUP DESC;








SELECT
    SUM(COALESCE(
        API_ACCEPT_ON_US_ACCEPT_APPLICATION_DECLINE_COUNT, 0
    )) AS API_ON_US_ACCEPT_DECLINE,

    SUM(COALESCE(
        API_ACCEPT_ON_US_REFER_APPLICATION_DECLINE_COUNT, 0
    )) AS API_ON_US_REFER_DECLINE,

    SUM(COALESCE(
        API_ACCEPT_ON_US_DECLINE_APPLICATION_DECLINE_COUNT, 0
    )) AS API_ON_US_DECLINE_DECLINE,

    SUM(COALESCE(
        DIRECT_ON_US_ACCEPT_APPLICATION_DECLINE_COUNT, 0
    )) AS DIRECT_ON_US_ACCEPT_DECLINE,

    SUM(COALESCE(
        DIRECT_ON_US_REFER_APPLICATION_DECLINE_COUNT, 0
    )) AS DIRECT_ON_US_REFER_DECLINE,

    SUM(COALESCE(
        DIRECT_ON_US_DECLINE_APPLICATION_DECLINE_COUNT, 0
    )) AS DIRECT_ON_US_DECLINE_DECLINE

FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

WHERE APPLICATION_DECISION_DATE >= DATE '2026-09-01'
  AND APPLICATION_DECISION_DATE < DATE '2026-10-01';










WITH CASE_DATA AS (
    SELECT
        APP.APPLICATION_IDENTIFIER,
        UPPER(TRIM(CSE.CASE_STATUS_CODE)) AS CASE_STATUS
    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION APP
    JOIN FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE CSE
        ON APP.APPLICATION_IDENTIFIER = CSE.APPLICATION_IDENTIFIER
    WHERE APP.ACTIVE = '1'
      AND CSE.ACTIVE = '1'
      AND CSE.CASE_TYPE = 'PRODUCTAPP'
      AND APP.APPLICATION_APPROVAL_DATE >= DATE '2026-09-01'
      AND APP.APPLICATION_APPROVAL_DATE < DATE '2026-10-01'
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY APP.APPLICATION_IDENTIFIER
        ORDER BY CSE.CASE_CREATION_DATE DESC
    ) = 1
),

F_APPLICATIONS AS (
    SELECT DISTINCT
        APPLICATION_IDENTIFIER
    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME
    WHERE QUOTE_STATUS_CODE = 'F'
)

SELECT
    COUNT_IF(
        C.CASE_STATUS = 'DECLINE'
    ) AS STRICT_DECLINE_COUNT,

    COUNT_IF(
        C.CASE_STATUS NOT IN ('COMPLETE', 'REFER')
    ) AS BROADER_DECLINE_COUNT,

    COUNT_IF(
        C.CASE_STATUS NOT IN ('COMPLETE', 'REFER')
        AND C.CASE_STATUS <> 'DECLINE'
    ) AS ADDITIONAL_STATUSES_COUNT

FROM CASE_DATA C
JOIN F_APPLICATIONS F
    ON C.APPLICATION_IDENTIFIER = F.APPLICATION_IDENTIFIER;