WITH max_change AS (
    SELECT
        TRANSACTION_IDENTIFIER,
        MAX(SOURCE_CHANGE_TIMESTAMP) AS MAX_CHANGE_TS
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS
    WHERE SOURCE_CHANGE_TIMESTAMP >= '2026-09-09 01:00:00'
    GROUP BY TRANSACTION_IDENTIFIER
),

max_insert AS (
    SELECT
        s.TRANSACTION_IDENTIFIER,
        MAX(s.SOURCE_INSERT_TIMESTAMP) AS MAX_INSERT_TS
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS s
    JOIN max_change m
      ON s.TRANSACTION_IDENTIFIER = m.TRANSACTION_IDENTIFIER
     AND s.SOURCE_CHANGE_TIMESTAMP = m.MAX_CHANGE_TS
    GROUP BY s.TRANSACTION_IDENTIFIER
)

SELECT
    COUNT(*) AS TRANSACTIONS_STILL_TIED
FROM (
    SELECT
        s.TRANSACTION_IDENTIFIER
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS s
    JOIN max_change m
      ON s.TRANSACTION_IDENTIFIER = m.TRANSACTION_IDENTIFIER
     AND s.SOURCE_CHANGE_TIMESTAMP = m.MAX_CHANGE_TS
    JOIN max_insert i
      ON s.TRANSACTION_IDENTIFIER = i.TRANSACTION_IDENTIFIER
     AND s.SOURCE_INSERT_TIMESTAMP = i.MAX_INSERT_TS
    GROUP BY s.TRANSACTION_IDENTIFIER
    HAVING COUNT(*) > 1
);