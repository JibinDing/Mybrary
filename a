SELECT
    APPLICATION_CREATED_DATE,
    SUM(TOTAL_API_ACCEPTS_US_ACCEPT_APPLICATIONS) AS ACCEPT_APP_COUNT,
    SUM(TOTAL_API_ACCEPTS_US_REFERRED_APPLICATIONS) AS REFER_APP_COUNT,
    SUM(TOTAL_API_ACCEPTS_US_ACCEPT_APPLICATIONS)
      + SUM(TOTAL_API_ACCEPTS_US_REFERRED_APPLICATIONS) AS AGGREGATOR_CONVERSION
FROM BDP_UK_CARDS.CARDS_AGGREGATOR_MULTIQUOTE
WHERE APPLICATION_CREATED_DATE = '2026-08-01'
  AND CHANNEL_LEVEL_1 = '3rd Parties'
  AND CHANNEL_LEVEL_2 = 'Aggs'
GROUP BY 1;