SELECT DISTINCT
    CSE.CASE_NUMBER
FROM PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB.FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE CSE
JOIN PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB.FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION APP
    ON CSE.APPLICATION_IDENTIFIER = APP.APPLICATION_IDENTIFIER
WHERE CSE.CASE_STATUS_CODE = 'COMPLETE'
  AND APP.ACTIVE = '1'
  AND APP.APPLICATION_APPROVAL_DATE = '2026-08-18'
  AND CSE.CASE_TYPE = 'PRODUCTAPP'
  AND CSE.ACTIVE = '1'
ORDER BY CSE.CASE_NUMBER;