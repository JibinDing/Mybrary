
WITH MART_COUNT AS (
    SELECT
        COUNT(*) AS MART_ROWS_NOW
    FROM U_BUKC_DSA_BIV_BT_DB.RECRUITMENT_MART0
),

SEP5_MATCH AS (
    SELECT
        COUNT(DISTINCT A.APPLICATION_ID)
            AS SEP5_MATCHED_IDS
    FROM A_UKC_CASMART_DB.APPLICATION A
    JOIN U_BUKC_DSA_BIV_BT_DB.RECRUITMENT_MART0 R
      ON A.APPLICATION_ID = R.APPLICATION_ID
    WHERE A.CREATED_DATE >= '2026-09-05'
      AND A.CREATED_DATE < '2026-09-06'
      AND A.DECISION_DATE >= '2026-09-01'
      AND A.DECISION_DATE < '2026-10-01'
)

SELECT
    M.MART_ROWS_NOW,
    S.SEP5_MATCHED_IDS
FROM MART_COUNT M
CROSS JOIN SEP5_MATCH S;
