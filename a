SELECT
    CASE
        WHEN DOWNSELL_COUNT = 0 THEN '0 - No Downsell'
        WHEN DOWNSELL_COUNT > 0 THEN '>0 - Genuine Downsell'
        WHEN DOWNSELL_COUNT IS NULL THEN 'NULL'
        ELSE 'Other'
    END AS DOWNSELL_SOURCE_STATUS,

    COUNT(*) AS RECORD_COUNT

FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME

WHERE UPPER(TRIM(REQUESTED_PRODUCT_CLASS_CODE)) = 'L'

GROUP BY 1

ORDER BY RECORD_COUNT DESC;