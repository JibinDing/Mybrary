SELECT
    MAX(SOURCE_CHANGE_TIMESTAMP) AS MAX_SOURCE_TIMESTAMP,
    COUNT(*) AS ROW_COUNT
FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS;


SELECT
    MAX(SOURCE_CHANGE_TIMESTAMP) AS MAX_SOURCE_TIMESTAMP,
    COUNT(*) AS ROW_COUNT
FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_AUTHORIZATION_TRANSACTION;


SELECT
    REPORT_DATE,
    MIN(DW_LOD_TMP) AS MIN_LOAD_TIMESTAMP,
    MAX(DW_LOD_TMP) AS MAX_LOAD_TIMESTAMP,
    COUNT(*) AS ROW_COUNT
FROM BDP_UK_CARDS.FACT_SMARTPAY_TRANSACTION_SUMMARY
GROUP BY REPORT_DATE
ORDER BY REPORT_DATE DESC;