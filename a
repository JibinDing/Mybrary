SELECT
    BANK_SCORE_ELIGIBLE_INDICATOR,

    CASE
        WHEN GEN_16_BANK_RISK_SCORE IS NULL
        THEN 'NULL'
        ELSE 'POPULATED'
    END AS GEN16_BANK_RISK_SCORE_STATUS,

    CASE
        WHEN BANK_SCORE_ELIGIBLE_INDICATOR = 1
         AND GEN_16_BANK_RISK_SCORE IS NOT NULL
        THEN 'Y'
        ELSE 'N'
    END AS EXPECTED_BARCLAYS_CUSTOMER_INDICATOR,

    COUNT(*) AS RECORD_COUNT

FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME

WHERE TRY_TO_DATE(DECISION_DATE) < DATE '2026-08-01'

GROUP BY
    BANK_SCORE_ELIGIBLE_INDICATOR,
    CASE
        WHEN GEN_16_BANK_RISK_SCORE IS NULL
        THEN 'NULL'
        ELSE 'POPULATED'
    END,
    CASE
        WHEN BANK_SCORE_ELIGIBLE_INDICATOR = 1
         AND GEN_16_BANK_RISK_SCORE IS NOT NULL
        THEN 'Y'
        ELSE 'N'
    END

ORDER BY RECORD_COUNT DESC;