SELECT
    ATTRIBUTE_NAME,
    TOTAL_ROWS,
    POPULATED_COUNT,
    NULL_COUNT,
    DISTINCT_COUNT
FROM (

    SELECT
        'RISK_SEGMENT' AS ATTRIBUTE_NAME,
        COUNT(*) AS TOTAL_ROWS,
        COUNT(RISK_SEGMENT) AS POPULATED_COUNT,
        COUNT(*) - COUNT(RISK_SEGMENT) AS NULL_COUNT,
        COUNT(DISTINCT RISK_SEGMENT) AS DISTINCT_COUNT
    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

    UNION ALL

    SELECT
        'RISK_SCORECARD_NAME',
        COUNT(*),
        COUNT(RISK_SCORECARD_NAME),
        COUNT(*) - COUNT(RISK_SCORECARD_NAME),
        COUNT(DISTINCT RISK_SCORECARD_NAME)
    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

    UNION ALL

    SELECT
        'BARCLAYS_CUSTOMER_INDICATOR',
        COUNT(*),
        COUNT(BARCLAYS_CUSTOMER_INDICATOR),
        COUNT(*) - COUNT(BARCLAYS_CUSTOMER_INDICATOR),
        COUNT(DISTINCT BARCLAYS_CUSTOMER_INDICATOR)
    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

    UNION ALL

    SELECT
        'ORIGIN_CODE',
        COUNT(*),
        COUNT(ORIGIN_CODE),
        COUNT(*) - COUNT(ORIGIN_CODE),
        COUNT(DISTINCT ORIGIN_CODE)
    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

    UNION ALL

    SELECT
        'PURCHASE_RATE',
        COUNT(*),
        COUNT(PURCHASE_RATE),
        COUNT(*) - COUNT(PURCHASE_RATE),
        COUNT(DISTINCT PURCHASE_RATE)
    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

    UNION ALL

    SELECT
        'SALARY_BAND',
        COUNT(*),
        COUNT(SALARY_BAND),
        COUNT(*) - COUNT(SALARY_BAND),
        COUNT(DISTINCT SALARY_BAND)
    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

    UNION ALL

    SELECT
        'BOOKED_ACCOUNTS_COUNT',
        COUNT(*),
        COUNT(BOOKED_ACCOUNTS_COUNT),
        COUNT(*) - COUNT(BOOKED_ACCOUNTS_COUNT),
        COUNT(DISTINCT BOOKED_ACCOUNTS_COUNT)
    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

    UNION ALL

    SELECT
        'TOTAL_ACCEPT_CREDIT_LIMIT_AMOUNT',
        COUNT(*),
        COUNT(TOTAL_ACCEPT_CREDIT_LIMIT_AMOUNT),
        COUNT(*) - COUNT(TOTAL_ACCEPT_CREDIT_LIMIT_AMOUNT),
        COUNT(DISTINCT TOTAL_ACCEPT_CREDIT_LIMIT_AMOUNT)
    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

)
ORDER BY ATTRIBUTE_NAME;