WITH smartpay_txns AS (
    SELECT DISTINCT
        TRANSACTION_IDENTIFIER
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_AUTHORIZATION_TRANSACTION
    WHERE TRIM(TRANSACTION_PURPOSE_CODE) IN (
        'DPNGCB',
        'NGCBRF',
        'RL_BLD',
        'RH_BLD',
        'FL_BLD',
        'FH_BLD',
        'IH_BLD',
        'IL_BLD'
    )
),

status_duration AS (
    SELECT
        s.TRANSACTION_IDENTIFIER,
        MIN(s.SOURCE_CHANGE_TIMESTAMP) AS FIRST_STATUS_TIMESTAMP,
        MAX(s.SOURCE_CHANGE_TIMESTAMP) AS LATEST_STATUS_TIMESTAMP,
        DATEDIFF(
            'hour',
            MIN(s.SOURCE_CHANGE_TIMESTAMP),
            MAX(s.SOURCE_CHANGE_TIMESTAMP)
        ) AS DURATION_HOURS,
        COUNT(*) AS STATUS_RECORD_COUNT
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS s
    JOIN smartpay_txns t
        ON s.TRANSACTION_IDENTIFIER = t.TRANSACTION_IDENTIFIER
    GROUP BY s.TRANSACTION_IDENTIFIER
)

SELECT
    COUNT(*) AS TOTAL_TRANSACTIONS,
    MAX(DURATION_HOURS) AS MAX_DURATION_HOURS,
    COUNT_IF(DURATION_HOURS > 24) AS OVER_24_HOURS,
    COUNT_IF(DURATION_HOURS > 48) AS OVER_48_HOURS,
    COUNT_IF(DURATION_HOURS > 72) AS OVER_72_HOURS,
    COUNT_IF(DURATION_HOURS > 120) AS OVER_120_HOURS
FROM status_duration;