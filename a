SELECT
    ACQUISITION_SEGMENT1,
    ACQ_SEGMENT2,
    COUNT(*) AS RECORD_COUNT,

    CASE
        WHEN ACQ_SEGMENT2 = 'Forward'
             AND ACQUISITION_SEGMENT1 = 'Forward'
            THEN 'PASS'

        WHEN ACQ_SEGMENT2 = 'Combo'
             AND ACQUISITION_SEGMENT1 = 'Platinum Combo'
            THEN 'PASS'

        WHEN ACQ_SEGMENT2 IN (
                'Platinum BT Short',
                'Platinum BT Mid',
                'Platinum BT Long'
             )
             AND ACQUISITION_SEGMENT1 = 'Platinum BT'
            THEN 'PASS'

        WHEN ACQ_SEGMENT2 IN (
                'Amazon',
                'Rewards',
                'Avios',
                'Avios Plus'
             )
             AND ACQUISITION_SEGMENT1 = 'Rewards'
            THEN 'PASS'

        WHEN ACQ_SEGMENT2 = 'Unknown'
             AND ACQUISITION_SEGMENT1 = 'Unknown'
            THEN 'PASS'

        ELSE 'FAIL'
    END AS TEST_RESULT

FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

GROUP BY
    ACQUISITION_SEGMENT1,
    ACQ_SEGMENT2

ORDER BY
    TEST_RESULT DESC,
    ACQUISITION_SEGMENT1,
    ACQ_SEGMENT2;




