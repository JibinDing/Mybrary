WITH ORIGIN_DATA AS (
    SELECT
        ORIGIN_PART_2,
        ORIGIN_PART_3,
        CONCAT(
            COALESCE(TRIM(CAST(ORIGIN_PART_2 AS STRING)), ''),
            COALESCE(TRIM(CAST(ORIGIN_PART_3 AS STRING)), '')
        ) AS COMBINED_ORIGIN_CODE
    FROM E_CASMART_BASE.IF023_APPLICATION
)

SELECT
    ORIGIN_PART_2,
    ORIGIN_PART_3,
    COMBINED_ORIGIN_CODE,
    COUNT(*) AS RECORD_COUNT
FROM ORIGIN_DATA
WHERE UPPER(COMBINED_ORIGIN_CODE) LIKE '%999MD%'
GROUP BY
    ORIGIN_PART_2,
    ORIGIN_PART_3,
    COMBINED_ORIGIN_CODE
ORDER BY RECORD_COUNT DESC;