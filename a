WITH LEGACY AS (
    SELECT
        COALESCE(
            NULLIF(TRIM(REQUESTED_PRODUCT_1_CODE), ''),
            'BLANK'
        ) AS PRODUCT_CODE,
        SUM(COALESCE(TOTAL_API_QUOTE, 0)) AS LEGACY_COUNT
    FROM BDP_UK_CARDS.CARDS_AGGREGATOR_MULTIQUOTE
    WHERE TRY_TO_DATE(
        LEFT(APPLICATION_CREATED_DATE, 10),
        'YYYY-MM-DD'
    ) = '2026-09-02'
    GROUP BY 1
),

NEW_BDP AS (
    SELECT
        COALESCE(
            NULLIF(TRIM(REQUESTED_PRODUCT_1_CODE), ''),
            'BLANK'
        ) AS PRODUCT_CODE,
        SUM(COALESCE(MEASURE_VALUE, 0)) AS NEW_COUNT
    FROM BDP_UK_CARDS.FACT_CARD_MULTIQUOTE_APPLICATION_DETAIL
    WHERE APPLICATION_CREATED_DATE = '2026-09-02'
      AND METRIC_IDENTIFIER = 'MPRDTCCT0006'
    GROUP BY 1
)

SELECT
    COALESCE(L.PRODUCT_CODE, N.PRODUCT_CODE) AS PRODUCT_CODE,
    COALESCE(L.LEGACY_COUNT, 0) AS LEGACY_COUNT,
    COALESCE(N.NEW_COUNT, 0) AS NEW_COUNT,
    COALESCE(N.NEW_COUNT, 0)
      - COALESCE(L.LEGACY_COUNT, 0) AS DIFFERENCE,
    CASE
        WHEN L.PRODUCT_CODE IS NULL THEN 'NEW ONLY'
        WHEN N.PRODUCT_CODE IS NULL THEN 'LEGACY ONLY'
        WHEN L.LEGACY_COUNT = N.NEW_COUNT THEN 'MATCH'
        ELSE 'MISMATCH'
    END AS RESULT
FROM LEGACY L
FULL OUTER JOIN NEW_BDP N
    ON L.PRODUCT_CODE = N.PRODUCT_CODE
ORDER BY ABS(
    COALESCE(N.NEW_COUNT, 0) - COALESCE(L.LEGACY_COUNT, 0)
) DESC;