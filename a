SELECT
    MIN(APPLICATION_DECISION_DATE) AS MIN_DATE,
    MAX(APPLICATION_DECISION_DATE) AS MAX_DATE,

    SUM(
        CASE
            WHEN DOWNSELL_INDICATOR = 'N'
            THEN COALESCE(APPLICATION_COUNT, 0)
            ELSE 0
        END
    ) AS DOWNSELL_N_VOLUME,

    SUM(
        CASE
            WHEN DOWNSELL_INDICATOR = 'Y'
            THEN COALESCE(APPLICATION_COUNT, 0)
            ELSE 0
        END
    ) AS DOWNSELL_Y_VOLUME

FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY
WHERE ACQUISITION_PRODUCT_NAME = 'Platinum BT Long';