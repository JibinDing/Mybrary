SELECT
    TO_DATE(CASE_CREATION_DATE) AS CASE_DATE,
    COUNT(*) AS TOTAL_PRODUCTAPP,
    COUNT_IF(ACTIVE = '1') AS ACTIVE_PRODUCTAPP
FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE
WHERE CASE_TYPE = 'PRODUCTAPP'
  AND CASE_CREATION_DATE >= '2026-01-01'
  AND CASE_CREATION_DATE < '2026-02-01'
GROUP BY 1
HAVING COUNT_IF(ACTIVE = '1') > 0
ORDER BY CASE_DATE;