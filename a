SELECT
    MIN(REPORT_DATE) AS EARLIEST_DATE,
    MAX(REPORT_DATE) AS LATEST_DATE,
    COUNT(*) AS TOTAL_ROWS,
    SUM(MEASURE_VOLUME) AS TOTAL_VOLUME,
    MIN(DW_LOAD_TMP) AS EARLIEST_LOAD_TIME,
    MAX(DW_LOAD_TMP) AS LATEST_LOAD_TIME
FROM BDP_UK_CARDS.FACT_SMARTPAY_TRANSACTION_SUMMARY
WHERE METRIC_IDENTIFIER = 'MPRDTCCT0001';