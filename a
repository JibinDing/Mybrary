SELECT
    CURRENT_DATABASE() AS DATABASE_NAME,
    COUNT(*) AS TOTAL_ROWS,
    MIN(APPLICATION_CREATED_DATE) AS EARLIEST_DATE,
    MAX(APPLICATION_CREATED_DATE) AS LATEST_DATE,
    COUNT_IF(
        APPLICATION_CREATED_DATE >= '2026-09-01'
        AND APPLICATION_CREATED_DATE < '2026-10-01'
    ) AS SEPTEMBER_ROWS,
    SUM(
        CASE
            WHEN APPLICATION_CREATED_DATE >= '2026-09-01'
             AND APPLICATION_CREATED_DATE < '2026-10-01'
            THEN COALESCE(APPLICATION_COUNT, 0)
            ELSE 0
        END
    ) AS SEPTEMBER_APPLICATION_COUNT
FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY;