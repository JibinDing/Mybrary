
WITH APP_CHECK AS (
    SELECT
        APPLICATION_IDENTIFIER,
        MAX(
            CASE
                WHEN ACTIVE = '1'
                 AND APPLICATION_APPROVAL_DATE >= '2026-09-01'
                 AND APPLICATION_APPROVAL_DATE < '2026-10-01'
                THEN 1 ELSE 0
            END
        ) AS VALID_ACTIVE_APP
    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION
    WHERE APPLICATION_IDENTIFIER IN (
        '10001015|378554328',
        '10001015|378611926',
        '10001015|378756513'
    )
    GROUP BY APPLICATION_IDENTIFIER
),

CHECK_FLAGS AS (
    SELECT
        A.APPLICATION_IDENTIFIER,
        A.VALID_ACTIVE_APP,

        CASE WHEN EXISTS (
            SELECT 1
            FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE C
            WHERE C.APPLICATION_IDENTIFIER =
                  A.APPLICATION_IDENTIFIER
              AND C.ACTIVE = '1'
              AND C.CASE_TYPE = 'PRODUCTAPP'
              AND C.CASE_CREATION_DATE >= '2026-09-01'
              AND C.CASE_CREATION_DATE < '2026-09-02'
        ) THEN 1 ELSE 0 END AS VALID_CASE,

        CASE WHEN EXISTS (
            SELECT 1
            FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME D
            WHERE D.APPLICATION_IDENTIFIER =
                  A.APPLICATION_IDENTIFIER
              AND D.QUOTE_STATUS_CODE = 'F'
        ) THEN 1 ELSE 0 END AS HAS_FULL_APP

    FROM APP_CHECK A
)

SELECT
    SPLIT_PART(APPLICATION_IDENTIFIER, '|', 2)
        AS APPLICATION_ID,
    VALID_ACTIVE_APP,
    VALID_CASE,
    HAS_FULL_APP,

    CASE
        WHEN HAS_FULL_APP = 0
            THEN 'NO FULL APPLICATION'
        WHEN VALID_ACTIVE_APP = 0
            THEN 'NO ACTIVE SEPT APPROVAL'
        WHEN VALID_CASE = 0
            THEN 'NO VALID PRODUCTAPP CASE'
        ELSE 'ALL CONDITIONS MET'
    END AS EXCLUSION_REASON

FROM CHECK_FLAGS
ORDER BY APPLICATION_ID;
