SELECT
    CASE
        WHEN CASE_CREATION_DATE < '2026-01-25'
            THEN 'Jan 01-24'
        ELSE 'Jan 25-31'
    END AS PERIOD,
    COUNT(*) AS TOTAL_CASE_ROWS,
    COUNT_IF(CASE_TYPE = 'PRODUCTAPP') AS PRODUCTAPP_ROWS,
    COUNT_IF(
        CASE_TYPE = 'PRODUCTAPP'
        AND ACTIVE = '1'
    ) AS ACTIVE_PRODUCTAPP_ROWS,
    MIN(CASE_CREATION_DATE) AS EARLIEST_DATE,
    MAX(CASE_CREATION_DATE) AS LATEST_DATE
FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE
WHERE CASE_CREATION_DATE >= '2026-01-01'
  AND CASE_CREATION_DATE < '2026-02-01'
GROUP BY 1
ORDER BY 1;