WITH DAILY_VOLUME AS (
    SELECT
        APPLICATION_CREATED_DATE,
        COUNT(*) AS ROW_COUNT,
        SUM(COALESCE(APPLICATION_COUNT, 0)) AS APPLICATION_VOLUME
    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY
    WHERE APPLICATION_CREATED_DATE >= DATEADD(DAY, -30, CURRENT_DATE())
    GROUP BY APPLICATION_CREATED_DATE
),

DATE_RANGE AS (
    SELECT
        DATEADD(
            DAY,
            SEQ4(),
            DATEADD(DAY, -30, CURRENT_DATE())
        ) AS APPLICATION_CREATED_DATE
    FROM TABLE(GENERATOR(ROWCOUNT => 31))
)

SELECT
    D.APPLICATION_CREATED_DATE,
    COALESCE(V.ROW_COUNT, 0) AS ROW_COUNT,
    COALESCE(V.APPLICATION_VOLUME, 0) AS APPLICATION_VOLUME,

    CASE
        WHEN V.APPLICATION_CREATED_DATE IS NULL
            THEN 'FAIL - MISSING DATE'

        WHEN COALESCE(V.APPLICATION_VOLUME, 0) = 0
            THEN 'FAIL - ZERO VOLUME'

        ELSE 'PASS'
    END AS TEST_RESULT

FROM DATE_RANGE D

LEFT JOIN DAILY_VOLUME V
    ON D.APPLICATION_CREATED_DATE = V.APPLICATION_CREATED_DATE

ORDER BY D.APPLICATION_CREATED_DATE DESC;


