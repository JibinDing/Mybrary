SELECT
    COUNT(*) AS DOWNSELL_NULL_RECORDS,

    SUM(CASE WHEN CREDIT_CARD_FINAL_LIMIT_AMOUNT IS NULL THEN 1 ELSE 0 END)
        AS FINAL_LIMIT_NULLS,

    SUM(CASE WHEN NET_MONTHLY_INCOME_AMOUNT IS NULL THEN 1 ELSE 0 END)
        AS NET_MONTHLY_INCOME_NULLS,

    SUM(CASE WHEN DECISION_ENGINE_APPLICATION_STATUS IS NULL THEN 1 ELSE 0 END)
        AS DECISION_STATUS_NULLS,

    SUM(CASE WHEN OFFERED_PRODUCT_DMI_CODE IS NULL THEN 1 ELSE 0 END)
        AS OFFERED_PRODUCT_DMI_NULLS,

    SUM(CASE WHEN INCOME_VALIDATION_REQUIRED_INDICATOR IS NULL THEN 1 ELSE 0 END)
        AS INCOME_VALIDATION_NULLS

FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME
WHERE DOWNSELL_COUNT IS NULL
  AND AUDIT_DATE >= '2026-01-01'
  AND AUDIT_DATE < '2027-01-01';