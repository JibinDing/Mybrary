SELECT
    APPLICATION_CHANNEL_CODE,
    COUNT(*) AS RECORD_COUNT,
    CASE
        WHEN REGEXP_LIKE(
            UPPER(TRIM(APPLICATION_CHANNEL_CODE)),
            '^[0-9]{3}[A-Z]{2}$'
        )
        THEN '3 DIGITS + 2 LETTERS'

        WHEN REGEXP_LIKE(
            UPPER(TRIM(APPLICATION_CHANNEL_CODE)),
            '^[0-9]{3}[A-Z]{2}[0-9]$'
        )
        THEN '3 DIGITS + 2 LETTERS + 1 DIGIT'

        ELSE 'OTHER FORMAT'
    END AS CODE_FORMAT

FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME

WHERE APPLICATION_CHANNEL_CODE IS NOT NULL

GROUP BY APPLICATION_CHANNEL_CODE

ORDER BY RECORD_COUNT DESC;