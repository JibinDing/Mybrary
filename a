
WITH TARGET_IDS AS (
    SELECT COLUMN1 AS APPLICATION_ID
    FROM VALUES
        ('378554328'),
        ('378611926'),
        ('378756513')
)

SELECT
    T.APPLICATION_ID,
    APP.APPLICATION_IDENTIFIER,
    APP.ACTIVE AS APP_ACTIVE,
    APP.APPLICATION_APPROVAL_DATE,
    CSE.CASE_CREATION_DATE,
    CSE.CASE_TYPE,
    CSE.ACTIVE AS CASE_ACTIVE,

    CASE
        WHEN EXISTS (
            SELECT 1
            FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME D
            WHERE D.APPLICATION_IDENTIFIER =
                  APP.APPLICATION_IDENTIFIER
              AND D.QUOTE_STATUS_CODE = 'F'
        )
        THEN 'Y'
        ELSE 'N'
    END AS HAS_FULL_APPLICATION

FROM TARGET_IDS T

LEFT JOIN FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION APP
    ON SPLIT_PART(
        APP.APPLICATION_IDENTIFIER, '|', -1
    ) = T.APPLICATION_ID

LEFT JOIN FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE CSE
    ON APP.APPLICATION_IDENTIFIER =
       CSE.APPLICATION_IDENTIFIER

ORDER BY T.APPLICATION_ID;
