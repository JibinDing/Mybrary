, APP_DUP_CHECK AS
(
    SELECT
        APPLICATION_IDENTIFIER,
        SDS_COUNTER,
        COUNT(*) AS RECORD_COUNT,
        COUNT(DISTINCT AUDIT_TIMESTAMP) AS AUDIT_TIMESTAMP_COUNT
    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME
    WHERE AUDIT_DATE >= :start_date
      AND AUDIT_DATE < DATEADD(DAY, 1, :end_date)
    GROUP BY
        APPLICATION_IDENTIFIER,
        SDS_COUNTER
    HAVING COUNT(*) > 1
),

SDS_DUP_CHECK AS
(
    SELECT
        SDS_APP,
        SDS_COUNTER,
        COUNT(*) AS RECORD_COUNT,
        COUNT(DISTINCT AUDIT_TIMESTAMP) AS AUDIT_TIMESTAMP_COUNT
    FROM IHQ_SDS_SORT
    GROUP BY
        SDS_APP,
        SDS_COUNTER
    HAVING COUNT(*) > 1
)

SELECT
    'APPLICATION_DECISION_OUTCOME' AS SOURCE,
    COUNT(*) AS DUPLICATE_KEY_COMBINATIONS,
    COALESCE(SUM(RECORD_COUNT), 0) AS RECORDS_IN_DUPLICATE_KEYS
FROM APP_DUP_CHECK

UNION ALL

SELECT
    'IHQ_SDS_SORT' AS SOURCE,
    COUNT(*) AS DUPLICATE_KEY_COMBINATIONS,
    COALESCE(SUM(RECORD_COUNT), 0) AS RECORDS_IN_DUPLICATE_KEYS
FROM SDS_DUP_CHECK;