SELECT
    AGGREGATOR_INDICATOR,

    SUM(API_ACCEPT_ON_US_ACCEPT_APPLICATION_COUNT) AS ACCEPT_APP_COUNT,
    SUM(API_ACCEPT_ON_US_REFER_APPLICATION_COUNT) AS REFER_APP_COUNT,

    SUM(API_ACCEPT_ON_US_ACCEPT_APPLICATION_COUNT)
      + SUM(API_ACCEPT_ON_US_REFER_APPLICATION_COUNT)
        AS AGGREGATOR_CONVERSION

FROM APPLICATION_SUMMARY_FINAL

WHERE APPLICATION_CREATED_DATE = '2026-08-01'
  AND LEVEL_1_CHANNEL_NAME = '3rd Parties'
  AND LEVEL_2_CHANNEL_NAME = 'Aggs'

GROUP BY 1
ORDER BY 4 DESC;