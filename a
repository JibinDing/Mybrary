SELECT
    APPLICATION_DECISION_DATE,
    AGGREGATOR_INDICATOR,

    SUM(COALESCE(APPLICATION_ACCEPT_COUNT, 0))
        AS APPLICATION_ACCEPT_COUNT,

    SUM(COALESCE(API_ACCEPT_ON_US_ACCEPT_APPLICATION_ACCEPT_COUNT, 0))
        AS API_ACCEPT_TO_APP_ACCEPT,

    SUM(COALESCE(API_ACCEPT_ON_US_REFER_APPLICATION_ACCEPT_COUNT, 0))
        AS API_REFER_TO_APP_ACCEPT,

    SUM(COALESCE(DIRECT_ON_US_ACCEPT_APPLICATION_ACCEPT_COUNT, 0))
        AS DIRECT_ACCEPT_TO_APP_ACCEPT,

    SUM(COALESCE(DIRECT_ON_US_REFER_APPLICATION_ACCEPT_COUNT, 0))
        AS DIRECT_REFER_TO_APP_ACCEPT,

    SUM(COALESCE(DIRECT_ON_US_DECLINE_APPLICATION_ACCEPT_COUNT, 0))
        AS DIRECT_DECLINE_TO_APP_ACCEPT,

    SUM(COALESCE(APPLICATION_ACCEPT_COUNT, 0))
    -
    (
        SUM(COALESCE(API_ACCEPT_ON_US_ACCEPT_APPLICATION_ACCEPT_COUNT, 0))
      + SUM(COALESCE(API_ACCEPT_ON_US_REFER_APPLICATION_ACCEPT_COUNT, 0))
      + SUM(COALESCE(DIRECT_ON_US_ACCEPT_APPLICATION_ACCEPT_COUNT, 0))
      + SUM(COALESCE(DIRECT_ON_US_REFER_APPLICATION_ACCEPT_COUNT, 0))
      + SUM(COALESCE(DIRECT_ON_US_DECLINE_APPLICATION_ACCEPT_COUNT, 0))
    ) AS DIFFERENCE

FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

WHERE APPLICATION_DECISION_DATE IN (
    DATE '2026-10-03',
    DATE '2026-09-08',
    DATE '2026-07-13'
)

GROUP BY
    APPLICATION_DECISION_DATE,
    AGGREGATOR_INDICATOR

HAVING DIFFERENCE <> 0

ORDER BY
    APPLICATION_DECISION_DATE DESC,
    AGGREGATOR_INDICATOR;