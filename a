SELECT
    AGGREGATOR_INDICATOR,

    SUM(APPLICATION_ACCEPT_COUNT) AS APPLICATION_ACCEPT_COUNT,

    SUM(API_ACCEPT_ON_US_ACCEPT_APPLICATION_ACCEPT_COUNT)
        AS API_ACCEPT,

    SUM(API_ACCEPT_ON_US_REFER_APPLICATION_ACCEPT_COUNT)
        AS API_REFER,

    SUM(API_ACCEPT_ON_US_DECLINE_APPLICATION_ACCEPT_COUNT)
        AS API_DECLINE,

    SUM(DIRECT_ON_US_ACCEPT_APPLICATION_ACCEPT_COUNT)
        AS DIRECT_ACCEPT,

    SUM(DIRECT_ON_US_REFER_APPLICATION_ACCEPT_COUNT)
        AS DIRECT_REFER,

    SUM(DIRECT_ON_US_DECLINE_APPLICATION_ACCEPT_COUNT)
        AS DIRECT_DECLINE

FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

GROUP BY AGGREGATOR_INDICATOR
ORDER BY AGGREGATOR_INDICATOR;