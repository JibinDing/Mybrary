SELECT
    ORIGIN_PART_2,
    ORIGIN_PART_3,
    CONCAT(
        COALESCE(TRIM(TO_VARCHAR(ORIGIN_PART_2)), ''),
        COALESCE(TRIM(TO_VARCHAR(ORIGIN_PART_3)), '')
    ) AS COMBINED_ORIGIN_CODE,
    COUNT(*) AS RECORD_COUNT

FROM E_CASMART_BASE.IF023_APPLICATION

WHERE UPPER(
    CONCAT(
        COALESCE(TRIM(TO_VARCHAR(ORIGIN_PART_2)), ''),
        COALESCE(TRIM(TO_VARCHAR(ORIGIN_PART_3)), '')
    )
) LIKE '%999MD%'

GROUP BY
    ORIGIN_PART_2,
    ORIGIN_PART_3

ORDER BY RECORD_COUNT DESC;