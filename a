WITH CLASSIFIED AS (
    SELECT
        CASE
            WHEN ORIGIN_CHANNEL_CODE IS NULL
             AND ORIGIN_CODE IS NULL
                THEN '1. Both NULL'

            WHEN ORIGIN_CHANNEL_CODE IS NULL
             AND UPPER(TRIM(ORIGIN_CODE)) = 'NA'
                THEN '2. Channel NULL / Origin NA'

            WHEN ORIGIN_CHANNEL_CODE IS NOT NULL
             AND UPPER(TRIM(ORIGIN_CODE)) = 'NA'
                THEN '3. Channel populated / Origin NA'

            WHEN ORIGIN_CHANNEL_CODE IS NULL
                THEN '4. Channel NULL / Origin populated'

            WHEN ORIGIN_CODE IS NULL
                THEN '5. Channel populated / Origin NULL'

            ELSE '6. Both populated'
        END AS ORIGIN_CATEGORY,

        APPLICATION_COUNT

    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY
)

SELECT
    ORIGIN_CATEGORY,
    COUNT(*) AS SUMMARY_ROW_COUNT,
    SUM(COALESCE(APPLICATION_COUNT, 0)) AS APPLICATION_VOLUME,

    ROUND(
        100.0 * SUM(COALESCE(APPLICATION_COUNT, 0))
        / NULLIF(
            SUM(SUM(COALESCE(APPLICATION_COUNT, 0))) OVER (),
            0
        ),
        2
    ) AS VOLUME_PCT

FROM CLASSIFIED

GROUP BY ORIGIN_CATEGORY

ORDER BY ORIGIN_CATEGORY;