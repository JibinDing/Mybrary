SELECT
    APPLICATION_CHANNEL_KEY,
    APPLICATION_CHANNEL_CODE,
    TRIM(TO_VARCHAR(APPLICATION_CHANNEL_KEY))
        || TRIM(APPLICATION_CHANNEL_CODE) AS COMBINED_ORIGIN_CODE,
    COUNT(*) AS RECORD_COUNT

FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME

WHERE TRY_TO_NUMBER(APPLICATION_CHANNEL_KEY) = 999

GROUP BY
    APPLICATION_CHANNEL_KEY,
    APPLICATION_CHANNEL_CODE

ORDER BY RECORD_COUNT DESC;