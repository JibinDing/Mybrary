SELECT
    UPPER(TRIM(CSE.CASE_STATUS_CODE)) AS FULL_APPLICATION_STATUS_CODE,
    COUNT(DISTINCT APP.APPLICATION_IDENTIFIER) AS APPLICATION_VOLUME
FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION APP
JOIN FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE CSE
    ON APP.APPLICATION_IDENTIFIER = CSE.APPLICATION_IDENTIFIER
WHERE APP.ACTIVE = '1'
  AND CSE.ACTIVE = '1'
  AND CSE.CASE_TYPE = 'PRODUCTAPP'

  AND APP.APPLICATION_APPROVAL_DATE >= DATE '2026-09-01'
  AND APP.APPLICATION_APPROVAL_DATE <  DATE '2026-10-01'

  AND EXISTS (
      SELECT 1
      FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME D
      WHERE D.APPLICATION_IDENTIFIER = APP.APPLICATION_IDENTIFIER
        AND D.QUOTE_STATUS_CODE IN ('Q', 'F')
  )

GROUP BY UPPER(TRIM(CSE.CASE_STATUS_CODE))
ORDER BY APPLICATION_VOLUME DESC;