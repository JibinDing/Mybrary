
SELECT
    COUNT(DISTINCT APP.APPLICATION_IDENTIFIER)
        AS FDP_DISTINCT_APPLICATION_IDS

FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION APP

JOIN FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE CSE
    ON APP.APPLICATION_IDENTIFIER =
       CSE.APPLICATION_IDENTIFIER

WHERE CSE.CASE_CREATION_DATE >= '2026-09-01'
  AND CSE.CASE_CREATION_DATE < '2026-10-01'

  AND APP.APPLICATION_APPROVAL_DATE >= '2026-09-01'
  AND APP.APPLICATION_APPROVAL_DATE < '2026-10-01'

  AND APP.ACTIVE = '1'
  AND CSE.ACTIVE = '1'
  AND CSE.CASE_TYPE = 'PRODUCTAPP'

  AND EXISTS (
      SELECT 1
      FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME D
      WHERE D.APPLICATION_IDENTIFIER =
            APP.APPLICATION_IDENTIFIER
        AND D.QUOTE_STATUS_CODE = 'F'
  );
