SELECT
    129931 AS LEGACY_APPLICATION_VOLUME,

    SUM(COALESCE(APPLICATION_COUNT, 0)) AS NCMI_APPLICATION_VOLUME,

    SUM(COALESCE(APPLICATION_COUNT, 0)) - 129931 AS DIFFERENCE,

    ROUND(
        (
            SUM(COALESCE(APPLICATION_COUNT, 0)) - 129931
        ) * 100.0 / 129931,
        2
    ) AS VARIANCE_PCT

FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

WHERE APPLICATION_CREATED_DATE >= DATE '2026-09-01'
  AND APPLICATION_CREATED_DATE <  DATE '2026-10-01';