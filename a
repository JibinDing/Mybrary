WITH LONG_BT AS (
    SELECT DISTINCT
        APPLICATION_ID
    FROM E_CASMART_DB.IF023_APPLICATION
    WHERE UPPER(TRIM(Downsell0_Initial_Flag)) = 'L'
      AND DECISION_DATE >= DATE '2026-01-01'
      AND DECISION_DATE <  DATE '2026-10-06'
),

IF023_DOWNSELL AS (
    SELECT
        S.APPLICATION_ID,
        MAX(S.DOWNSELL_COUNTER) AS DOWNSELL_COUNTER
    FROM E_CASMART_DB.IF023_SUMMARY S
    INNER JOIN LONG_BT L
        ON S.APPLICATION_ID = L.APPLICATION_ID
    GROUP BY S.APPLICATION_ID
)

SELECT
    CASE
        WHEN DOWNSELL_COUNTER IS NULL THEN 'NULL'
        WHEN DOWNSELL_COUNTER = 0 THEN '0 - No Downsell'
        WHEN DOWNSELL_COUNTER > 0 THEN '>0 - Downsell'
        ELSE 'OTHER'
    END AS DOWNSELL_GROUP,
    COUNT(*) AS APPLICATION_COUNT,
    ROUND(
        100.0 * COUNT(*) / SUM(COUNT(*)) OVER (),
        2
    ) AS PERCENTAGE
FROM IF023_DOWNSELL
GROUP BY 1
ORDER BY 1;