SELECT
    TABLE_NAME,
    COLUMN_NAME,
    DATA_TYPE
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'BDP_UK_CARDS'
  AND TABLE_NAME IN (
      'CARDS_AGGREGATOR_MULTIQUOTE',
      'FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY'
  )
  AND (
      COLUMN_NAME ILIKE '%DECLIN%'
      OR COLUMN_NAME ILIKE '%DATE%'
  )
ORDER BY TABLE_NAME, COLUMN_NAME;