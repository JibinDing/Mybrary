MAX(
    CASE
        WHEN CSE.CASE_STATUS_CODE IS NOT NULL
         AND UPPER(TRIM(CSE.CASE_STATUS_CODE)) <> 'WITHDRAWN'
        THEN 1
        ELSE 0
    END
) OVER (
    PARTITION BY APP.LINKED_APPLICATION_NUMBER
) AS HAS_NON_WITHDRAWN



QUALIFY RN = 1
    AND HAS_COMPLETE = 0
    AND HAS_NON_WITHDRAWN = 1
    AND (
        CSE.CASE_STATUS_CODE IS NULL
        OR UPPER(TRIM(CSE.CASE_STATUS_CODE)) = 'WITHDRAWN'
    );