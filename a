WITH WINDOWS AS (
    SELECT
        'SEPT_ONLY' AS TEST_WINDOW,
        '2026-09-01'::DATE AS START_DATE,
        '2026-10-01'::DATE AS END_DATE

    UNION ALL

    SELECT
        'SEP_TO_OCT' AS TEST_WINDOW,
        '2026-09-01'::DATE,
        '2026-10-22'::DATE
),
RANKED AS (
    SELECT
        W.TEST_WINDOW,
        D.APPLICATION_NUMBER,
        D.AUDIT_DATE,
        D.AUDIT_TIMESTAMP,
        D.SDS_COUNTER,

        RANK() OVER (
            PARTITION BY
                W.TEST_WINDOW,
                D.APPLICATION_IDENTIFIER
            ORDER BY
                D.QUOTE_STATUS_CODE,
                D.SDS_COUNTER DESC
        ) AS LAST_PASS

    FROM WINDOWS W
    JOIN FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME D
        ON D.AUDIT_DATE >= W.START_DATE
       AND D.AUDIT_DATE < W.END_DATE

    WHERE D.APPLICATION_NUMBER = '378756513'
      AND D.QUOTE_STATUS_CODE = 'F'
)
SELECT *
FROM RANKED
WHERE LAST_PASS = 1
ORDER BY TEST_WINDOW;