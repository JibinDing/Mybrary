Validate that Direct On-Us Eligibility Conversion includes all applications
that reached a final accepted application outcome, irrespective of whether
the interim Direct On-Us decision was Accept, Refer or Decline.


Direct On-Us Conversion should equal:

Direct On-Us Accept → Application Accept
+ Direct On-Us Refer → Application Accept
+ Direct On-Us Decline → Application Accept.

The calculated conversion volume should not exceed the total Direct On-Us
Eligibility Checks for each application decision date.



WITH DAILY_CHECK AS (
    SELECT
        APPLICATION_DECISION_DATE,

        SUM(COALESCE(DIRECT_ON_US_CHECK_COUNT, 0))
            AS DIRECT_ON_US_ELIGIBILITY,

        SUM(COALESCE(DIRECT_ON_US_ACCEPT_APPLICATION_ACCEPT_COUNT, 0))
            AS ACCEPT_TO_APP_ACCEPT,

        SUM(COALESCE(DIRECT_ON_US_REFER_APPLICATION_ACCEPT_COUNT, 0))
            AS REFER_TO_APP_ACCEPT,

        SUM(COALESCE(DIRECT_ON_US_DECLINE_APPLICATION_ACCEPT_COUNT, 0))
            AS DECLINE_TO_APP_ACCEPT

    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

    WHERE APPLICATION_DECISION_DATE IS NOT NULL

    GROUP BY APPLICATION_DECISION_DATE
)

SELECT
    APPLICATION_DECISION_DATE,

    DIRECT_ON_US_ELIGIBILITY,

    ACCEPT_TO_APP_ACCEPT,
    REFER_TO_APP_ACCEPT,
    DECLINE_TO_APP_ACCEPT,

    ACCEPT_TO_APP_ACCEPT
      + REFER_TO_APP_ACCEPT
      + DECLINE_TO_APP_ACCEPT
        AS DIRECT_ON_US_CONVERSION,

    DIRECT_ON_US_ELIGIBILITY
      - (
            ACCEPT_TO_APP_ACCEPT
          + REFER_TO_APP_ACCEPT
          + DECLINE_TO_APP_ACCEPT
        ) AS REMAINING_VOLUME,

    CASE
        WHEN ACCEPT_TO_APP_ACCEPT
           + REFER_TO_APP_ACCEPT
           + DECLINE_TO_APP_ACCEPT
             <= DIRECT_ON_US_ELIGIBILITY
        THEN 'PASS'
        ELSE 'FAIL'
    END AS TEST_RESULT

FROM DAILY_CHECK

ORDER BY APPLICATION_DECISION_DATE DESC;