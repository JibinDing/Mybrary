, NO_COMPLETE_MIXED AS (
    SELECT
        LINKED_APPLICATION_NUMBER
    FROM BASE
    GROUP BY LINKED_APPLICATION_NUMBER
    HAVING
        COUNT(DISTINCT CASE
            WHEN UPPER(TRIM(FULL_APPLICATION_STATUS_CODE)) <> 'WITHDRAWN'
            THEN UPPER(TRIM(FULL_APPLICATION_STATUS_CODE))
        END) > 1

        AND COUNT(DISTINCT CASE
            WHEN UPPER(TRIM(FULL_APPLICATION_STATUS_CODE)) = 'COMPLETE'
            THEN APPLICATION_IDENTIFIER
        END) = 0
),

NO_COMPLETE_COMBOS AS (
    SELECT
        B.LINKED_APPLICATION_NUMBER,

        LISTAGG(
            DISTINCT UPPER(TRIM(B.FULL_APPLICATION_STATUS_CODE)),
            ' + '
        ) WITHIN GROUP (
            ORDER BY UPPER(TRIM(B.FULL_APPLICATION_STATUS_CODE))
        ) AS STATUS_COMBINATION

    FROM BASE B
    JOIN NO_COMPLETE_MIXED N
      ON B.LINKED_APPLICATION_NUMBER = N.LINKED_APPLICATION_NUMBER

    WHERE UPPER(TRIM(B.FULL_APPLICATION_STATUS_CODE)) <> 'WITHDRAWN'

    GROUP BY B.LINKED_APPLICATION_NUMBER
)

SELECT
    STATUS_COMBINATION,
    COUNT(*) AS GROUP_COUNT
FROM NO_COMPLETE_COMBOS
GROUP BY STATUS_COMBINATION
ORDER BY GROUP_COUNT DESC;