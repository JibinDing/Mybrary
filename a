SELECT
    COUNT(*) AS TOTAL_VERSIONS,

    COUNT_IF(
        APPLICATION_APPROVAL_DATE >= '2026-09-01'
        AND APPLICATION_APPROVAL_DATE < '2026-10-01'
    ) AS SEPTEMBER_VERSIONS,

    COUNT_IF(
        ACTIVE = '1'
    ) AS ACTIVE_VERSIONS,

    COUNT_IF(
        ACTIVE = '1'
        AND APPLICATION_APPROVAL_DATE >= '2026-09-01'
        AND APPLICATION_APPROVAL_DATE < '2026-10-01'
    ) AS ACTIVE_SEPTEMBER_VERSIONS

FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION

WHERE APPLICATION_IDENTIFIER IN (
    SELECT DISTINCT APPLICATION_IDENTIFIER
    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME
    WHERE APPLICATION_NUMBER = '378756513'
);