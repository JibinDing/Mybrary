WITH APP_POPULATION AS
(
    SELECT
        CAS.APPLICATION_IDENTIFIER,
        CAS.CASE_CREATION_DATE,
        APP.APPLICATION_APPROVAL_DATE,
        APP.APPLICATION_RECEIVE_DATE,
        APP.LINKED_APPLICATION_NUMBER,
        APP.INTERNET_MEDIA_CODE,
        APP.CHANNEL_CODE,

        DATEDIFF(
            'DAY',
            CAS.CASE_CREATION_DATE,
            APP.APPLICATION_APPROVAL_DATE
        ) AS DAYS_TO_APPROVAL,

        ROW_NUMBER() OVER (
            PARTITION BY CAS.APPLICATION_IDENTIFIER
            ORDER BY APP.APPLICATION_APPROVAL_DATE DESC
        ) AS RN

    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE CAS

    LEFT JOIN FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION APP
        ON CAS.APPLICATION_IDENTIFIER = APP.APPLICATION_IDENTIFIER
       AND APP.ACTIVE = '1'

    WHERE CAS.CASE_CREATION_DATE >= '2026-01-01'
      AND CAS.CASE_TYPE = 'PRODUCTAPP'
      AND CAS.ACTIVE = '1'
)

SELECT
    APPLICATION_IDENTIFIER,
    CASE_CREATION_DATE,
    APPLICATION_APPROVAL_DATE,
    DAYS_TO_APPROVAL,
    APPLICATION_RECEIVE_DATE,
    LINKED_APPLICATION_NUMBER,
    INTERNET_MEDIA_CODE,
    CHANNEL_CODE
FROM APP_POPULATION
WHERE RN = 1
  AND DAYS_TO_APPROVAL > 60
ORDER BY DAYS_TO_APPROVAL DESC;