, CANCEL_COMPLETE_GROUPS AS (
    SELECT
        LINKED_APPLICATION_NUMBER
    FROM BASE
    GROUP BY LINKED_APPLICATION_NUMBER
    HAVING
        COUNT(DISTINCT CASE
            WHEN UPPER(TRIM(FULL_APPLICATION_STATUS_CODE)) = 'COMPLETE'
            THEN APPLICATION_IDENTIFIER
        END) > 0
        AND
        COUNT(DISTINCT CASE
            WHEN UPPER(TRIM(FULL_APPLICATION_STATUS_CODE)) = 'CANCEL'
            THEN APPLICATION_IDENTIFIER
        END) > 0
        AND
        COUNT(DISTINCT CASE
            WHEN UPPER(TRIM(FULL_APPLICATION_STATUS_CODE))
                 NOT IN ('COMPLETE', 'CANCEL', 'WITHDRAWN')
            THEN APPLICATION_IDENTIFIER
        END) = 0
)

SELECT
    UPPER(TRIM(B.FULL_APPLICATION_STATUS_CODE)) AS LATEST_STATUS,
    COUNT(*) AS GROUP_COUNT
FROM BASE B
JOIN CANCEL_COMPLETE_GROUPS C
  ON B.LINKED_APPLICATION_NUMBER = C.LINKED_APPLICATION_NUMBER
WHERE B.LATEST_APP_RN = 1
GROUP BY 1
ORDER BY 2 DESC;