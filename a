, MULTI_NON_WITHDRAWN AS (
    SELECT LINKED_APPLICATION_NUMBER
    FROM BASE
    GROUP BY LINKED_APPLICATION_NUMBER
    HAVING COUNT(DISTINCT APPLICATION_IDENTIFIER) > 1
       AND COUNT(DISTINCT CASE
               WHEN UPPER(TRIM(FULL_APPLICATION_STATUS_CODE)) <> 'WITHDRAWN'
               THEN APPLICATION_IDENTIFIER
           END) > 1
)

SELECT
    UPPER(TRIM(B.FULL_APPLICATION_STATUS_CODE)) AS LATEST_APP_STATUS,
    COUNT(*) AS LINKED_APPLICATION_GROUPS
FROM BASE B
JOIN MULTI_NON_WITHDRAWN M
  ON B.LINKED_APPLICATION_NUMBER = M.LINKED_APPLICATION_NUMBER
WHERE B.LATEST_APP_RN = 1
GROUP BY 1
ORDER BY 2 DESC;




, GROUP_FLAGS AS (
    SELECT
        LINKED_APPLICATION_NUMBER,
        MAX(
            CASE
                WHEN UPPER(TRIM(FULL_APPLICATION_STATUS_CODE)) = 'COMPLETE'
                THEN 1 ELSE 0
            END
        ) AS HAS_COMPLETE
    FROM BASE
    GROUP BY LINKED_APPLICATION_NUMBER
),

LATEST AS (
    SELECT
        LINKED_APPLICATION_NUMBER,
        APPLICATION_IDENTIFIER,
        FULL_APPLICATION_STATUS_CODE
    FROM BASE
    WHERE LATEST_APP_RN = 1
)

SELECT
    UPPER(TRIM(L.FULL_APPLICATION_STATUS_CODE)) AS LATEST_STATUS,
    COUNT(*) AS GROUP_COUNT
FROM GROUP_FLAGS G
JOIN LATEST L
  ON G.LINKED_APPLICATION_NUMBER = L.LINKED_APPLICATION_NUMBER
WHERE G.HAS_COMPLETE = 1
  AND UPPER(TRIM(L.FULL_APPLICATION_STATUS_CODE)) <> 'COMPLETE'
GROUP BY 1
ORDER BY 2 DESC;