WITH CASE_DATA AS (
    SELECT
        APP.APPLICATION_IDENTIFIER,
        UPPER(TRIM(CSE.CASE_STATUS_CODE)) AS CASE_STATUS
    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION APP
    JOIN FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE CSE
        ON APP.APPLICATION_IDENTIFIER = CSE.APPLICATION_IDENTIFIER
    WHERE APP.ACTIVE = '1'
      AND CSE.ACTIVE = '1'
      AND CSE.CASE_TYPE = 'PRODUCTAPP'
      AND APP.APPLICATION_APPROVAL_DATE >= DATE '2026-09-01'
      AND APP.APPLICATION_APPROVAL_DATE < DATE '2026-10-01'
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY APP.APPLICATION_IDENTIFIER
        ORDER BY CSE.CASE_CREATION_DATE DESC
    ) = 1
),
F_APPLICATIONS AS (
    SELECT DISTINCT
        APPLICATION_IDENTIFIER
    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME
    WHERE QUOTE_STATUS_CODE = 'F'
)
SELECT
    C.CASE_STATUS,
    COUNT(*) AS APPLICATION_COUNT
FROM CASE_DATA C
JOIN F_APPLICATIONS F
    ON C.APPLICATION_IDENTIFIER = F.APPLICATION_IDENTIFIER
WHERE C.CASE_STATUS NOT IN ('COMPLETE', 'REFER')
GROUP BY C.CASE_STATUS
ORDER BY APPLICATION_COUNT DESC;