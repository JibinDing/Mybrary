FROM PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB.BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY
WHERE APPLICATION_DECISION_DATE = '2026-08-18'
