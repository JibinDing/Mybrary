WITH MONTHLY_VOLUME AS (
    SELECT
        DATE_TRUNC('MONTH', APPLICATION_CREATED_DATE)
            AS APPLICATION_MONTH,

        SUM(
            COALESCE(APPLICATION_COUNT, 0)
        ) AS APPLICATION_VOLUME

    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY

    WHERE APPLICATION_DECISION_DATE >= DATE '2026-09-01'
      AND APPLICATION_DECISION_DATE < DATE '2026-10-01'

    GROUP BY 1
)

SELECT
    CASE
        WHEN GROUPING(APPLICATION_MONTH) = 1
            THEN 'TOTAL'
        WHEN APPLICATION_MONTH IS NULL
            THEN 'NULL'
        ELSE TO_CHAR(APPLICATION_MONTH, 'YYYY-MM')
    END AS APPLICATION_MONTH,

    SUM(APPLICATION_VOLUME) AS APPLICATION_VOLUME

FROM MONTHLY_VOLUME

GROUP BY ROLLUP(APPLICATION_MONTH)

ORDER BY
    GROUPING(APPLICATION_MONTH),
    1;