WITH DECISION AS (
    SELECT
        APPLICATION_IDENTIFIER,
        UPPER(TRIM(DECISION_ENGINE_APPLICATION_STATUS)) AS DECISION_STATUS,

        ROW_NUMBER() OVER (
            PARTITION BY APPLICATION_IDENTIFIER
            ORDER BY SDS_COUNTER DESC
        ) AS RN

    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME

    WHERE AUDIT_DATE >= '2026-01-01'
      AND QUOTE_STATUS_CODE = 'F'
),

CASE_DATA AS (
    SELECT
        APPLICATION_IDENTIFIER,
        UPPER(TRIM(CASE_STATUS_CODE)) AS CASE_STATUS

    FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE

    WHERE CASE_CREATION_DATE >= '2026-01-01'
      AND CASE_TYPE = 'PRODUCTAPP'
      AND ACTIVE = '1'
)

SELECT
    D.DECISION_STATUS,
    C.CASE_STATUS,
    COUNT(DISTINCT D.APPLICATION_IDENTIFIER) AS APPLICATION_COUNT

FROM DECISION D

LEFT JOIN CASE_DATA C
    ON D.APPLICATION_IDENTIFIER = C.APPLICATION_IDENTIFIER

WHERE D.RN = 1

GROUP BY
    D.DECISION_STATUS,
    C.CASE_STATUS

ORDER BY
    D.DECISION_STATUS,
    APPLICATION_COUNT DESC;