SELECT
    COUNT(*) AS TOTAL_RECORDS,

    COUNT_IF(APPLICATION_CHANNEL_CODE IS NULL)
        AS NULL_RECORDS,

    COUNT_IF(APPLICATION_CHANNEL_CODE IS NOT NULL)
        AS POPULATED_RECORDS,

    COUNT(DISTINCT APPLICATION_CHANNEL_CODE)
        AS DISTINCT_CODES,

    COUNT_IF(
        UPPER(TRIM(APPLICATION_CHANNEL_CODE)) LIKE '%999MD%'
    ) AS AMAZON_CODE_RECORDS

FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME;