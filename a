SELECT
    TABLE_NAME,
    COLUMN_NAME,
    DATA_TYPE
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'FDP_UK_CARDS_DB'
  AND TABLE_NAME IN (
      'CREDIT_CARD_APPLICATION',
      'CREDIT_CARD_APPLICATION_DECISION_OUTCOME'
  )
  AND (
      COLUMN_NAME ILIKE '%APPROV%'
      OR COLUMN_NAME ILIKE '%CREATION_DATE%'
      OR COLUMN_NAME ILIKE '%CREATED_DATE%'
      OR COLUMN_NAME ILIKE '%AUDIT_DATE%'
  )
ORDER BY TABLE_NAME, COLUMN_NAME;