WITH max_status_ts AS (
    SELECT
        TRANSACTION_IDENTIFIER,
        MAX(SOURCE_CHANGE_TIMESTAMP) AS MAX_SOURCE_CHANGE_TIMESTAMP
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS
    WHERE SOURCE_CHANGE_TIMESTAMP >= '2026-09-09 01:00:00'
    GROUP BY TRANSACTION_IDENTIFIER
),

latest_ties AS (
    SELECT
        s.TRANSACTION_IDENTIFIER,
        COUNT(*) AS ROWS_AT_LATEST_TIMESTAMP,
        COUNT(DISTINCT s.TRANSACTION_STATUS_CODE) AS DISTINCT_STATUS_COUNT
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS s
    JOIN max_status_ts m
      ON s.TRANSACTION_IDENTIFIER = m.TRANSACTION_IDENTIFIER
     AND s.SOURCE_CHANGE_TIMESTAMP = m.MAX_SOURCE_CHANGE_TIMESTAMP
    GROUP BY s.TRANSACTION_IDENTIFIER
    HAVING COUNT(*) > 1
)

SELECT
    COUNT(*) AS TRANSACTIONS_WITH_TIED_LATEST,
    COUNT_IF(DISTINCT_STATUS_COUNT > 1) AS TIES_WITH_DIFFERENT_STATUSES,
    MAX(ROWS_AT_LATEST_TIMESTAMP) AS MAX_ROWS_AT_LATEST
FROM latest_ties;