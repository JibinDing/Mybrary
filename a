SELECT
    COUNT(*) AS TOTAL_UNMATCHED,

    SUM(
        CASE
            WHEN EXISTS (
                SELECT 1
                FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME APP2
                WHERE APP2.APPLICATION_IDENTIFIER = SDS.SDS_APP
                  AND APP2.SDS_COUNTER = SDS.SDS_COUNTER
            )
            THEN 1
            ELSE 0
        END
    ) AS MATCH_EXISTS_WITHOUT_TIMESTAMP,

    SUM(
        CASE
            WHEN NOT EXISTS (
                SELECT 1
                FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME APP2
                WHERE APP2.APPLICATION_IDENTIFIER = SDS.SDS_APP
                  AND APP2.SDS_COUNTER = SDS.SDS_COUNTER
            )
            THEN 1
            ELSE 0
        END
    ) AS NO_MATCH_EVEN_WITHOUT_TIMESTAMP

FROM IHQ_SDS_SORT SDS

LEFT JOIN FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME APP
    ON SDS.SDS_APP = APP.APPLICATION_IDENTIFIER
   AND SDS.SDS_COUNTER = APP.SDS_COUNTER
   AND SDS.AUDIT_TIMESTAMP = APP.AUDIT_TIMESTAMP

WHERE SDS.AUDIT_TIMESTAMP >= '2026-01-01'
  AND SDS.AUDIT_TIMESTAMP <  '2027-01-01'
  AND APP.APPLICATION_IDENTIFIER IS NULL;