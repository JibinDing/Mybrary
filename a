SELECT
    APPLICATION_IDENTIFIER,
    APPLICATION_NUMBER,
    DECISION_DATE,
    REQUESTED_PRODUCT_CLASS_CODE,
    DOWNSELL_COUNT
FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_DECISION_OUTCOME
WHERE TRIM(TO_VARCHAR(APPLICATION_NUMBER)) IN (
    '135944245',
    '135926234',
    '135902147',
    '135830269',
    '135993931'
)
ORDER BY
    APPLICATION_NUMBER,
    DECISION_DATE;