l, MULTI_APP_GROUPS AS (
    SELECT
        LINKED_APPLICATION_NUMBER
    FROM BASE
    GROUP BY LINKED_APPLICATION_NUMBER
    HAVING COUNT(DISTINCT APPLICATION_IDENTIFIER) > 1
),

PROPOSED_SELECTION AS (
    SELECT
        B.*,

        ROW_NUMBER() OVER (
            PARTITION BY B.LINKED_APPLICATION_NUMBER
            ORDER BY
                CASE
                    WHEN UPPER(TRIM(B.FULL_APPLICATION_STATUS_CODE)) = 'COMPLETE'
                        THEN 1
                    WHEN UPPER(TRIM(B.FULL_APPLICATION_STATUS_CODE)) <> 'WITHDRAWN'
                        THEN 2
                    ELSE 3
                END,
                B.EFF_START_DATE DESC,
                B.APPLICATION_IDENTIFIER DESC
        ) AS PROPOSED_RN

    FROM BASE B
    JOIN MULTI_APP_GROUPS M
      ON B.LINKED_APPLICATION_NUMBER = M.LINKED_APPLICATION_NUMBER
)

SELECT
    UPPER(TRIM(FULL_APPLICATION_STATUS_CODE)) AS SELECTED_STATUS,
    COUNT(*) AS LINKED_APPLICATION_GROUPS
FROM PROPOSED_SELECTION
WHERE PROPOSED_RN = 1
GROUP BY 1
ORDER BY 2 DESC;