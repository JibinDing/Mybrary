WITH OLD AS (
    SELECT
        CHANNEL_LEVEL_3,
        ACQUISITION_SEGMENT2,
        SUM(QUOTE_TO_APPLICATION) AS OLD_COUNT
    FROM BDP_UK_CARDS.CARDS_AGGREGATOR_MULTIQUOTE
    WHERE APPLICATION_CREATED_DATE = '2026-08-01'
      AND CHANNEL_LEVEL_1 = '3rd Parties'
      AND CHANNEL_LEVEL_2 = 'Aggs'
    GROUP BY 1,2
),

NEW AS (
    SELECT
        LEVEL_3_CHANNEL_NAME,
        ACQUISITION_PRODUCT_NAME,
        SUM(APPLICATION_COUNT) AS NEW_COUNT
    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY
    WHERE APPLICATION_CREATED_DATE = '2026-08-01'
      AND LEVEL_1_CHANNEL_NAME = '3rd Parties'
      AND LEVEL_2_CHANNEL_NAME = 'Aggs'
    GROUP BY 1,2
)

SELECT
    COALESCE(O.CHANNEL_LEVEL_3, N.LEVEL_3_CHANNEL_NAME) AS CHANNEL_LEVEL_3,
    COALESCE(O.ACQUISITION_SEGMENT2, N.ACQUISITION_PRODUCT_NAME)
        AS ACQUISITION_PRODUCT_NAME,
    COALESCE(O.OLD_COUNT, 0) AS OLD_COUNT,
    COALESCE(N.NEW_COUNT, 0) AS NEW_COUNT,
    COALESCE(N.NEW_COUNT, 0) - COALESCE(O.OLD_COUNT, 0) AS DIFFERENCE
FROM OLD O
FULL OUTER JOIN NEW N
    ON COALESCE(O.CHANNEL_LEVEL_3, 'NULL')
     = COALESCE(N.LEVEL_3_CHANNEL_NAME, 'NULL')
   AND COALESCE(O.ACQUISITION_SEGMENT2, 'NULL')
     = COALESCE(N.ACQUISITION_PRODUCT_NAME, 'NULL')
WHERE COALESCE(O.OLD_COUNT, 0) <> COALESCE(N.NEW_COUNT, 0)
ORDER BY 1,2;