WITH DAILY_VOLUME AS (
    SELECT
        TO_DATE(APPLICATION_DECISION_DATE) AS DECISION_DATE,
        SUM(COALESCE(APPLICATION_COUNT, 0)) AS APPLICATION_VOLUME
    FROM BDP_UK_CARDS.FACT_CARD_AGGREGATOR_APPLICATION_SUMMARY
    WHERE APPLICATION_DECISION_DATE >= DATE '2026-09-01'
      AND APPLICATION_DECISION_DATE < DATE '2026-10-01'
    GROUP BY 1
)

SELECT
    CASE
        WHEN GROUPING(DECISION_DATE) = 1 THEN 'TOTAL'
        ELSE TO_CHAR(DECISION_DATE, 'YYYY-MM-DD')
    END AS DECISION_DATE,

    SUM(APPLICATION_VOLUME) AS NCMI_APPLICATION_VOLUME

FROM DAILY_VOLUME
GROUP BY ROLLUP(DECISION_DATE)

ORDER BY
    GROUPING(DECISION_DATE),
    DECISION_DATE;