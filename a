WITH ngcb_auth AS (
    SELECT DISTINCT TRANSACTION_IDENTIFIER
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_AUTHORIZATION_TRANSACTION
    WHERE SOURCE_INSERT_TIMESTAMP >= '2026-08-02 00:00:00'
      AND TRIM(TRANSACTION_PURPOSE_CODE) IN (
          'DPNGCB',
          'NGCBRF'
      )
),
status_txns AS (
    SELECT DISTINCT TRANSACTION_IDENTIFIER
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS
)
SELECT
    COUNT(*) AS TOTAL_NGCB_TRANSACTIONS,
    COUNT_IF(s.TRANSACTION_IDENTIFIER IS NOT NULL)
        AS MATCHED_TRANSACTIONS,
    COUNT_IF(s.TRANSACTION_IDENTIFIER IS NULL)
        AS MISSING_TRANSACTIONS
FROM ngcb_auth a
LEFT JOIN status_txns s
    ON a.TRANSACTION_IDENTIFIER = s.TRANSACTION_IDENTIFIER;