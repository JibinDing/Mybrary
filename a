WITH APP_POPULATION AS
(
    SELECT DISTINCT
        CAS.APPLICATION_IDENTIFIER,
        CAS.CASE_CREATION_DATE,
        APP.APPLICATION_APPROVAL_DATE,
        APP.APPLICATION_RECEIVE_DATE,
        APP.LINKED_APPLICATION_NUMBER,
        APP.INTERNET_MEDIA_CODE,
        APP.CHANNEL_CODE,

        DATEDIFF(
            'DAY',
            CAS.CASE_CREATION_DATE,
            APP.APPLICATION_APPROVAL_DATE
        ) AS DAYS_TO_APPROVAL

    FROM
    (
        SELECT
            APPLICATION_IDENTIFIER,
            CASE_CREATION_DATE
        FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION_CASE
        WHERE CASE_CREATION_DATE >= '2026-01-01'
          AND CASE_TYPE = 'PRODUCTAPP'
          AND ACTIVE = '1'
    ) CAS

    LEFT JOIN
    (
        SELECT
            APPLICATION_IDENTIFIER,
            APPLICATION_APPROVAL_DATE,
            APPLICATION_RECEIVE_DATE,
            LINKED_APPLICATION_NUMBER,
            INTERNET_MEDIA_CODE,
            CHANNEL_CODE
        FROM FDP_UK_CARDS_DB.CREDIT_CARD_APPLICATION
        WHERE ACTIVE = '1'
    ) APP
        ON CAS.APPLICATION_IDENTIFIER = APP.APPLICATION_IDENTIFIER
)

SELECT
    COUNT(DISTINCT APPLICATION_IDENTIFIER) AS TOTAL_APPLICATIONS,
    COUNT_IF(APPLICATION_APPROVAL_DATE IS NOT NULL) AS APPLICATIONS_WITH_APPROVAL_DATE,

    MIN(DAYS_TO_APPROVAL) AS MIN_DAYS_TO_APPROVAL,
    MAX(DAYS_TO_APPROVAL) AS MAX_DAYS_TO_APPROVAL,
    ROUND(AVG(DAYS_TO_APPROVAL), 2) AS AVG_DAYS_TO_APPROVAL,

    COUNT_IF(DAYS_TO_APPROVAL > 60) AS APPLICATIONS_OVER_60_DAYS,

    ROUND(
        100.0 * COUNT_IF(DAYS_TO_APPROVAL > 60)
        / NULLIF(COUNT_IF(APPLICATION_APPROVAL_DATE IS NOT NULL), 0),
        2
    ) AS PCT_OVER_60_DAYS

FROM APP_POPULATION;