WITH latest_status AS (
    SELECT *
    FROM FDP_UK_CARDS_DB.PAYMENT_GATEWAY_TRANSACTION_STATUS
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY TRANSACTION_IDENTIFIER
        ORDER BY SOURCE_CHANGE_TIMESTAMP DESC
    ) = 1
)
SELECT
    TRANSACTION_STATUS_CODE,
    COUNT(*) AS CNT
FROM latest_status
WHERE TRANSACTION_STATUS_CODE IN (
    'DUPLICATE_POSTED_TRAN',
    'GATHER_BROWSER_INFO',
    'VALIDATION_FAILED',
    'DIARY_NOTE_MADE'
)
GROUP BY TRANSACTION_STATUS_CODE
ORDER BY TRANSACTION_STATUS_CODE;

