SELECT
    REQUESTED_PRODUCT_CLASS_CODE,
    SOURCE_PRODUCT_CODE,
    COUNT(*) CNT
FROM PROD_BUK_SNSVC0073314_CARDS_BUSINESS_DB
     .FDP_UK_CARDS_DB
     .CREDIT_CARD_APPLICATION_DECISION_OUTCOME
WHERE AUDIT_DATE = '2026-07-26'   -- 用你刚刚跑的日期
GROUP BY
    REQUESTED_PRODUCT_CLASS_CODE,
    SOURCE_PRODUCT_CODE
ORDER BY 1,2;