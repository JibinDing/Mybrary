SELECT
    APPLICATION_DECISION_DATE,
    LEVEL_1_CHANNEL_NAME,
    AGGREGATOR_INDICATOR,
    SUM(APPLICATION_ACCEPT_COUNT) AS ACCEPTED_APPLICATIONS
FROM CARDS.AGGREGATOR_MULTIQUOTE
WHERE APPLICATION_DECISION_DATE = '2026-08-18'
GROUP BY
    APPLICATION_DECISION_DATE,
    LEVEL_1_CHANNEL_NAME,
    AGGREGATOR_INDICATOR
ORDER BY
    LEVEL_1_CHANNEL_NAME,
    AGGREGATOR_INDICATOR;