SELECT
    APPLICATION_DECISION_DATE,
    SUM(APPLICATION_ACCEPT_COUNT) AS APPLICATION_ACCEPT_COUNT,
    SUM(ACCEPTED_ACCOUNTS) AS ACCEPTED_ACCOUNTS,
    SUM(BOOKED_ACCOUNTS) AS BOOKED_ACCOUNTS,
    SUM(ACCEPTED_APPLICATIONS) AS ACCEPTED_APPLICATIONS
FROM CARDS.AGGREGATOR_MULTIQUOTE
WHERE APPLICATION_DECISION_DATE = '2026-08-18'
GROUP BY APPLICATION_DECISION_DATE;